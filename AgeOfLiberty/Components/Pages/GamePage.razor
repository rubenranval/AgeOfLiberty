    private int _renderQueued;
    private bool _disposed;

    private void OnStateChanged()
    {
        if (_disposed) return;
        _saveDirty = true;
        try { CivicIndicators.RecordIfNewTurn(State, Config, Economy.GetIncomeRate()); } catch { }
        if (Interlocked.Exchange(ref _renderQueued, 1) == 1) return;
        _ = InvokeAsync(FlushRenderAsync);
    }

    private async Task FlushRenderAsync()
    {
        // Collapse bursts from an economy tick, a cascade, and JS callbacks into
        // one frame. This keeps the large Razor tree from rendering repeatedly.
        await Task.Delay(16);
        Interlocked.Exchange(ref _renderQueued, 0);
        if (!_disposed) StateHasChanged();
    }

