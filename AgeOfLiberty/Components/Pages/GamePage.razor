    {
        var count = State.GetBuiltCount(atomId);
        if (!Config.AtomsById.TryGetValue(atomId, out var atom)) return 0;
        var thresholds = GetThresholdsForAtom(atom);
        int prevThreshold = 0;
        foreach (var t in thresholds)
        {
            if (count < t) return (double)(count - prevThreshold) / (t - prevThreshold);
            prevThreshold = t;
        }
        return 1.0; // maxed out
    }

