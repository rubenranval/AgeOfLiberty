    // ─── Issue Scheduler: time-released dilemmas ─────────────────────────
    private const int IssueMinS = 40;
    private const int IssueMaxS = 7200;          // 2h cap
    private const double IssueCurve = 1.5;       // geometric ladder
    private System.Timers.Timer? _issueTicker;
    private DateTime _nextIssueUtc = DateTime.MaxValue;
    private bool _issueHeld;                     // matured, waiting in the chip
    private bool _autoOpenPending;               // will auto-open when surface is idle
    private bool _dispatchesOpen;
    private DispatchFilter _dispatchFilter;
    private int _issueEraId = -1;
    private string _issueCountdown = "";

    private List<Scenario> EraScenarioList => Config.Scenarios
        .Where(sc => sc.EraId == CurrentEra.Id)
        .OrderBy(sc => sc.TriggerPop).ThenBy(sc => sc.SortOrder).ToList();
    private int EraIssuesDone => IssueProgress.Done(CurrentEra.Id);
    private int EraIssuesTotal => EraScenarioList.Count;
    private bool EraIssuesRemain => EraIssuesDone < EraIssuesTotal;

    // Era gate: population may outrun the narrative, but the era only
    // advances when every issue of the previous era has been answered.
    private int GatedEraIdx
    {
        get
        {
            int allowed = 0;
            int unlockedIdx = Math.Clamp(State.HighestEraIndex, 0, Math.Max(0, Config.Eras.Count - 1));
            while (allowed < unlockedIdx)
            {
                var era = Config.Eras[allowed];
                int total = Config.Scenarios.Count(sc => sc.EraId == era.Id);
                if (IssueProgress.Done(era.Id) >= total) allowed++;
                else break;
            }
            return allowed;
        }
    }

    // Ceremony for era N is allowed once era N-1's issues are all answered.
    // (Population is implied: the economy only raises EraUnlockAnimIndex on pop.)
    private bool EraCeremonyAllowed(int eraIdx)
    {
        if (eraIdx <= 0) return true;
        int prev = Math.Min(eraIdx - 1, Config.Eras.Count - 1);
        var prevEra = Config.Eras[prev];
        int total = Config.Scenarios.Count(sc => sc.EraId == prevEra.Id);
        return IssueProgress.Done(prevEra.Id) >= total;
    }

    private TimeSpan IssueInterval(int done)
    {
        var s = IssueMinS * Math.Pow(IssueCurve, done);
        // Endgame acceleration: pop threshold already met → the engine fast-forwards
        if (Config.GetEraIndex(State.Population) > GatedEraIdx) s /= 2;
        // Tutorial pace: the first era never waits more than 60s —
        // players should reach their first era ceremony quickly.
        var cap = GatedEraIdx == 0 ? 60 : IssueMaxS;
        return TimeSpan.FromSeconds(Math.Clamp(s, IssueMinS, cap));
    }

    private void StartIssueTicker()
    {
        _issueTicker?.Stop();
        _issueTicker = new System.Timers.Timer(1000);
        _issueTicker.Elapsed += (_, __) => InvokeAsync(TickIssues);
        _issueTicker.Start();
    }

    private void InitEraSchedule()
    {
        _issueEraId = CurrentEra.Id;
        if (!EraIssuesRemain) { _nextIssueUtc = DateTime.MaxValue; NotificationHelper.CancelIssue(); return; }
        var savedEra = Preferences.Get("aol_next_issue_era", -1);
        var savedTicks = Preferences.Get("aol_next_issue_ticks", 0L);
        if (savedEra == _issueEraId && savedTicks > 0)
        {
            _nextIssueUtc = new DateTime(savedTicks, DateTimeKind.Utc);
            if (DateTime.UtcNow >= _nextIssueUtc) { _issueHeld = true; _autoOpenPending = true; }
        }
        else
        {
            ScheduleNextIssue();
        }
    }

    private void ScheduleNextIssue()
    {
        _issueHeld = false;
        _autoOpenPending = false;
        if (!EraIssuesRemain)
        {
            _nextIssueUtc = DateTime.MaxValue;
            Preferences.Remove("aol_next_issue_ticks");
            NotificationHelper.CancelIssue();
            return;
        }
        _nextIssueUtc = DateTime.UtcNow + IssueInterval(EraIssuesDone);
        Preferences.Set("aol_next_issue_era", _issueEraId);
        Preferences.Set("aol_next_issue_ticks", _nextIssueUtc.Ticks);
        _ = NotificationHelper.ScheduleIssueAsync(_nextIssueUtc);
    }

    private void TickIssues()
    {
        if (State.Phase == GamePhase.Intro || !_loaded) return;
        var renderNeeded = false;

        // Debounced autosave + time-played flush — MUST run before any early
        // return below (e.g. the era-complete state used to skip it entirely).
        if (++_saveTick >= 5)
        {
            _saveTick = 0;
            FlushTimePlayed();
            if (_saveDirty)
            {
                if (SaveService.Save(State, _eraStartUtc, _eraStartPop))
                    _saveDirty = false;
                // on failure the flag stays set — retried next tick
            }
        }

        // ── Sequential ceremony queue ──
        // The engine overwrites EraUnlockAnimIndex on every pop crossing, which
        // loses ceremonies when pop outruns the issue ladder. The Razor now owns
        // the value: ceremonies fire strictly in order, each when its gate opens.
        if (_eraRevealPhase == EraRevealPhase.None && State.Phase == GamePhase.Play)
        {
            int want = _lastCeremonyEra + 1;
            int? desired = (want <= GatedEraIdx && want < Config.Eras.Count) ? want : (int?)null;
            if (State.EraUnlockAnimIndex != desired)
            {
                State.EraUnlockAnimIndex = desired;
                renderNeeded = true;
            }
        }

        if (_issueEraId != CurrentEra.Id) InitEraSchedule();
        if (!EraIssuesRemain)
        {
            if (_issueCountdown.Length > 0)
            {
                _issueCountdown = "";
                _ = JS.InvokeVoidAsync("AgeOfLiberty.setText", "issueCountdown", "");
            }
            if (renderNeeded) StateHasChanged();
            return;
        }

        var now = DateTime.UtcNow;
        if (!_issueHeld && now >= _nextIssueUtc)
        {
            _issueHeld = true;
            _autoOpenPending = true;
            renderNeeded = true;
            NotificationHelper.CancelIssue();
        }
        if (_issueHeld && _autoOpenPending && CanAutoOpenIssue())
        {
            _autoOpenPending = false;
            _ = AutoOpenWithGrace();
        }
        _issueCountdown = _issueHeld ? "" : FmtCountdown(_nextIssueUtc - now);
        _ = JS.InvokeVoidAsync("AgeOfLiberty.setText", "issueCountdown", _issueCountdown);
        if (renderNeeded) StateHasChanged();
    }

    private bool CanAutoOpenIssue() =>
        State.Phase == GamePhase.Play
        && _activeTab == Tab.Map
        && State.ActiveScenario == null
        && !State.DrawerOpen
        && !(State.EraUnlockAnimIndex is int pendingEra && EraCeremonyAllowed(pendingEra))
        && _eraRevealPhase == EraRevealPhase.None
        && _stockViewAtomId == null
        && !_dispatchesOpen
        && !_pressureDetailsOpen
        && !_goalsOpen
        && !_fabOpen
        && !_tutorialActive;

