    // ─── Hex Geometry ───────────────────────────────────────────────────
    private static string HexPts(double cx, double cy, double r)
    {
        // Flat-top hexagon, squashed vertically (0.58) — isometric ground tile
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < 6; i++)
        {
            var a = Math.PI / 180 * (60 * i);
            sb.Append($"{cx + r * Math.Cos(a):F1},{cy + r * Math.Sin(a) * 0.58:F1} ");
        }
        return sb.ToString().TrimEnd();
    }

    // ─── The Seen and the Unseen: price influence engine ─────────────────
    private const int AnatomyWindowTurns = 24;

    private class PriceInfluence
    {
        public int ApplyTurn; public string Label = ""; public double Mult = 1;
        public string? LearnUrl; public string? LearnLabel; public bool IsDelayed;
    }

    private class MarkerInfo
    {
        public int Turn; public string Label = ""; public double? Mult; public double X;
        public string? LearnUrl; public string? LearnLabel;
    }
    private MarkerInfo? _selectedMarker;

    // Every multiplier a past decision applied (or will have applied) to this atom.
    private List<PriceInfluence> GetInfluences(int atomId, int? windowTurns)
    {
        var list = new List<PriceInfluence>();
        foreach (var ev in State.ChoiceEvents)
        {
            if (ev.ChoiceId == 0) continue;
            var choice = Config.Choices.FirstOrDefault(ch => ch.Id == ev.ChoiceId);
            if (choice == null) continue;
            var (imm, del) = Config.GetEffects(ev.ChoiceId);
            foreach (var e in imm.Where(e => e.AtomId == atomId))
                list.Add(new PriceInfluence { ApplyTurn = ev.Turn, Label = choice.Label, Mult = e.Multiplier, LearnUrl = choice.LearnUrl, LearnLabel = choice.LearnLabel });
            foreach (var e in del.Where(e => e.AtomId == atomId))
            {
                var at = ev.Turn + choice.DelayTurns;
                if (at <= State.Turn)
                    list.Add(new PriceInfluence { ApplyTurn = at, Label = choice.Label, Mult = e.Multiplier, IsDelayed = true, LearnUrl = choice.LearnUrl, LearnLabel = choice.LearnLabel });
            }
        }
        if (windowTurns is int w) list = list.Where(i => State.Turn - i.ApplyTurn <= w).ToList();
        return list.OrderByDescending(i => i.ApplyTurn).ToList();
    }

    // Counterfactual series: what the price would have been without your decisions.
    private List<int> BuildGhostSeries(int atomId, List<int> padded, int historyCount)
    {
        var infs = GetInfluences(atomId, null);
        if (infs.Count == 0) return new List<int>();
        int pad = padded.Count - historyCount;
        var ghost = new List<int>(padded.Count);
        bool diff = false;
        for (int i = 0; i < padded.Count; i++)
        {
            int turn = i - pad + 1;
            double d = 1;
            foreach (var inf in infs) if (inf.ApplyTurn <= turn && inf.Mult > 0) d *= inf.Mult;
            var g = Math.Max(1, (int)Math.Round(padded[i] / d));
            if (g != padded[i]) diff = true;
            ghost.Add(g);
        }
        return diff ? ghost : new List<int>();
    }

    // Aggregate index for the City view: sum of all available-atom prices,
    // seen vs the timeline your decisions erased.
    private (List<int> seen, List<int> ghost) BuildCityIndex()
    {
        var hist = State.PriceHistory;
        var atoms = AvailableAtoms;
        var seen = new List<int>(); var ghost = new List<int>();
        if (hist.Count < 2 || atoms.Count == 0) return (seen, ghost);
        var infMap = atoms.ToDictionary(a => a.Id, a => GetInfluences(a.Id, null));
        bool diff = false;
        for (int i = 0; i < hist.Count; i++)
        {
            int turn = i + 1;
            double s = 0, g = 0;
            foreach (var a in atoms)
            {
                var p = (double)hist[i].Prices.GetValueOrDefault(a.Id, a.BasePrice);
                s += p;
                double d = 1;
                foreach (var inf in infMap[a.Id]) if (inf.ApplyTurn <= turn && inf.Mult > 0) d *= inf.Mult;
                g += p / d;
            }
            seen.Add((int)Math.Round(s));
            ghost.Add((int)Math.Round(g));
            if (seen[i] != ghost[i]) diff = true;
        }
        if (!diff) ghost = new List<int>();
        return (seen, ghost);
    }

