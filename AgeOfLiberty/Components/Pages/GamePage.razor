    private void DismissFeedback()
    {
        // Prevent the choice tap that created this card from immediately
        // dismissing it as the overlay mounts beneath the pointer.
        if (DateTime.UtcNow - _dispatchOpenedAt < TimeSpan.FromMilliseconds(350)) return;
        if (ActiveDispatch is GameDispatch dispatch) dispatch.IsRead = true;
        State.ActiveDispatchId = null;
        State.NotifyStateChanged();
    }

    private async Task DismissToastAfterAsync(string dispatchId, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(3800, cancellationToken);
            if (State.ToastDispatchId == dispatchId)
            {
                State.ToastDispatchId = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

