        if (eraIdx <= 1) return BadgeThresholds[0];
        if (eraIdx <= 3) return BadgeThresholds[1];
        return BadgeThresholds[2];
    }

    private int GetBadgeTier(int atomId)
    {
        var count = State.GetBuiltCount(atomId);
        if (!Config.AtomsById.TryGetValue(atomId, out var atom)) return 0;
        var thresholds = GetThresholdsForAtom(atom);
        int tier = 0;
        for (int i = 0; i < thresholds.Length; i++)
        {
            if (count >= thresholds[i]) tier = i + 1;
        }
        return tier; // 0=none, 1=bronze, 2=silver, 3=gold, 4=platinum, 5=diamond
    }

