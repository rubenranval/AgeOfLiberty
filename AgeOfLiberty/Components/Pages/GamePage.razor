    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loaded) return;

        if (!_particlesInitialized)
        {
            await Task.Delay(150);
            try { await JS.InvokeVoidAsync("AgeOfLiberty.initParticles", "bgParticles"); _particlesInitialized = true; } catch { }
        }

        if (State.Phase == GamePhase.Intro && !_introStarted)
        {
            _introStarted = true;
            _ = RunIntroBoot();
        }

        // Character entrance: typewrite the line + play the voice sting, once per opening
        if (State.ActiveScenario is Scenario spk && spk.Id != _spokenScenarioId)
        {
            _spokenScenarioId = spk.Id;
            var spkChar = Config.CharsById.GetValueOrDefault(spk.CharacterId);
            if (!string.IsNullOrWhiteSpace(spk.CharacterLine))
            {
                try { await JS.InvokeVoidAsync("AgeOfLibertyIntro.typeText", "charLine", spk.CharacterLine.Replace("{cityName}", State.CityName)); } catch { }
            }
            if (!string.IsNullOrWhiteSpace(spkChar?.VoiceAsset))
            {
                try { await JS.InvokeVoidAsync("AoLVoice.play", $"assets/characters/{spkChar.VoiceAsset}"); } catch { }
            }
        }

        if (_tutorialActive)
        {
            if (!_tutCanvasReady)
            {
                _tutCanvasReady = true;
                try { await JS.InvokeVoidAsync("AgeOfLibertyIntro.initMini", "tutCanvas"); } catch { }
            }
            if (State.DrawerOpen) AdvanceTutFromDrawer();
        }

        if (State.Phase == GamePhase.Play && _activeTab == Tab.Map && !_gesturesInitialized)
        {
            await Task.Delay(100);
                try
                {
                    _dotnetRef ??= DotNetObjectReference.Create(this);
                    await JS.InvokeVoidAsync("AgeOfLiberty.initTouchGestures", "graphArea", _dotnetRef, _panX, _panY, _zoom);
                    _gesturesInitialized = true;
                }
                catch { }
        }

        if (State.Phase == GamePhase.Play && _activeTab == Tab.Map && !_edgeParticlesInitialized)
        {
            await Task.Delay(100);
            try { await JS.InvokeVoidAsync("AgeOfLiberty.initEdgeParticles", "atomSvg"); _edgeParticlesInitialized = true; await UpdateEdgeParticles(); } catch { }
        }

        if (_edgeParticlesInitialized)
        {
            var hash = State.Built.Sum(kv => kv.Key * 1000 + kv.Value);
            if (hash != _lastBuiltHash) { _lastBuiltHash = hash; await UpdateEdgeParticles(); }
        }

        if (State.EraUnlockAnimIndex is int eraUnlockIdx && eraUnlockIdx != _lastEraUnlockIdx && EraCeremonyAllowed(eraUnlockIdx))
        {
            _lastEraUnlockIdx = eraUnlockIdx;
            // Snapshot the closing era's numbers and freeze the simulation —
            // single source of truth for both trigger paths (driver or engine).
            _ceremonyTime = FmtEraTime(DateTime.UtcNow - _eraStartUtc);
            _ceremonyCitizens = EconomyEngine.FormatNumber(Math.Max(0, State.Population - _eraStartPop));
            _ceremonyShownAt = DateTime.UtcNow;
            Economy.Stop();
            try { _ = JS.InvokeVoidAsync("AgeOfLibertyJuice.setActive", false); } catch { }
            StateHasChanged();
            await Task.Delay(150);
            try
            {
                var color = Config.Eras[eraUnlockIdx].Color;
                await JS.InvokeVoidAsync("AgeOfLibertyEra.showBadge", "eraChestCanvas", color);
                await JS.InvokeVoidAsync("AgeOfLibertyAudio.sfxEraUnlock");
                // Staggered reveal of era stat cards
                await JS.InvokeVoidAsync("AgeOfLibertyJuice.revealEraCards", 3);
            }
            catch { }
        }
        else if (State.EraUnlockAnimIndex == null && _lastEraUnlockIdx != null && _eraRevealPhase == EraRevealPhase.None)
        {
            _lastEraUnlockIdx = null;
        }

        var hasScenario = State.ActiveScenario != null;
        if (hasScenario && !_lastHadScenario)
        {
            try
            {
                await JS.InvokeVoidAsync("AgeOfLibertyAudio.sfxScenario");
                await Task.Delay(100);
                await JS.InvokeVoidAsync("AgeOfLibertyJuice.scenarioEntrance");
            }
            catch { }
        }
        _lastHadScenario = hasScenario;

        // Cascade juice — detect newly cascading atoms and fire effects
        var visibleIds = AvailableAtoms.Select(a => a.Id).ToHashSet();
        var currentCascading = new HashSet<int>(State.Cascading.Where(kv => kv.Value && visibleIds.Contains(kv.Key)).Select(kv => kv.Key));
        var newCascades = currentCascading.Except(_lastCascadingIds).ToList();
        if (newCascades.Count > 0)
        {
            try { await JS.InvokeVoidAsync("AgeOfLibertyAudio.sfxCascade"); } catch { }
            foreach (var cid in newCascades)
            {
                if (Config.AtomsById.TryGetValue(cid, out var cascAtom))
                {
                    try
                    {
                        await JS.InvokeVoidAsync("AgeOfLibertyJuice.cascadeHitAt",
                            "atomSvg", cascAtom.PositionX, RY(cascAtom), 0);

                        // Fire traveling pulse along each dependency edge
                        foreach (var dep in Config.GetDependencies(cid))
                        {
                            if (Config.AtomsById.TryGetValue(dep.RequiresAtomId, out var reqAtom))
                            {
                                await JS.InvokeVoidAsync("AgeOfLibertyJuice.travelingPulseAt",
                                    "atomSvg", reqAtom.PositionX, RY(reqAtom),
                                    cascAtom.PositionX, RY(cascAtom), 500, "#ff5648");
                            }
                        }
                    }
                    catch { }
                }
            }
        }
        _lastCascadingIds = currentCascading;

        // Income coin drift — fire when gold increases
        if (State.Gold > _lastGoldForCoins && _lastGoldForCoins > 0 && _activeTab == Tab.Map)
        {
            var builtNodes = AvailableAtoms
                .Where(a => State.GetBuiltCount(a.Id) > 0)
                .Select(a => new { x = a.PositionX, y = RY(a) })
                .ToList();
            if (builtNodes.Count > 0)
            {
                try { await JS.InvokeVoidAsync("AgeOfLibertyJuice.incomeTickAt", "atomSvg", builtNodes, "hudGold"); } catch { }
            }
        }
        _lastGoldForCoins = State.Gold;

        // Population milestone — celebrate every 25 citizens
        var popMilestone = (int)(State.Population / 25) * 25;
        if (popMilestone > _lastPopForMilestone && _lastPopForMilestone > 0)
        {
            try
            {
                await JS.InvokeVoidAsync("AgeOfLibertyJuice.populationMilestone", "hudPop");
                await JS.InvokeVoidAsync("AgeOfLibertyJuice.hudBump", "hudPop");
            }
            catch { }
        }
        _lastPopForMilestone = popMilestone;

        if (State.ActiveDispatchId != null && State.ActiveDispatchId != _lastShownDispatchId)
        {
            _lastShownDispatchId = State.ActiveDispatchId;
            _dispatchOpenedAt = DateTime.UtcNow;
        }
        else if (State.ActiveDispatchId == null)
        {
            _lastShownDispatchId = null;
        }

        if (State.ToastDispatchId is string toastId && toastId != _scheduledToastId)
        {
            _scheduledToastId = toastId;
            _toastCts?.Cancel();
            _toastCts?.Dispose();
            _toastCts = new CancellationTokenSource();
            try { await JS.InvokeVoidAsync("AgeOfLibertyAudio.sfxNotify"); } catch { }
            _ = DismissToastAfterAsync(toastId, _toastCts.Token);
        }
    }

    private async Task UpdateEdgeParticles()
    {
        var edges = new List<object>();
        foreach (var atom in AvailableAtoms)
        {
            if (State.GetBuiltCount(atom.Id) == 0) continue;
            foreach (var dep in Config.GetDependencies(atom.Id))
            {
                if (!Config.AtomsById.TryGetValue(dep.RequiresAtomId, out var reqAtom)) continue;
                edges.Add(new { x1 = reqAtom.PositionX, y1 = RY(reqAtom), x2 = atom.PositionX, y2 = RY(atom) });
            }
        }
        try { await JS.InvokeVoidAsync("AgeOfLiberty.updateEdges", edges); } catch { }
    }

