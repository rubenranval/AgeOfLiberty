@page "/"
@using System.Linq
@using AgeOfLiberty.Models
@using AgeOfLiberty.Services
@inject GameState State
@inject GameConfigStore Config
@inject EconomyEngine Economy
@inject CityPressureEngine Pressure
@inject ScenarioEngine Scenarios
@inject DirectusClient Directus
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (!_loaded)
{
    <div class="load-screen">
        <div class="load-core">
            <div class="load-mark">Age of Liberty</div>
            <div class="load-bar"><div class="load-bar-fill @(_loadError != null ? "halt" : "")"></div></div>
            <div class="boot-status @(_loadError != null ? "load-err" : "")">@(_loadError ?? "Retrieving simulation data")</div>
        </div>
    </div>
}
else
{
    <canvas id="bgParticles" class="bg-particles"></canvas>

    @if (State.Phase == GamePhase.Intro)
    {
        <div class="intro-screen" @onclick="IntroTap">
            @if (_introFading)
            {
                <div class="intro-fadeout"></div>
            }
            @if (_introPhase != IntroPhase.Commit && _introPhase != IntroPhase.Naming)
            {
                <button class="intro-skip" @onclick="IntroSkip" @onclick:stopPropagation="true">SKIP INTRO ›</button>
            }

            @if (_introPhase == IntroPhase.Boot || _introPhase == IntroPhase.Awakening)
            {
                <div class="intro-blackout @(_introPhase == IntroPhase.Awakening ? "out" : "")"></div>
            }

            <canvas id="introCanvas" class="intro-canvas"></canvas>
            <div class="intro-stage">
                <div class="intro-badge-space"></div>

                @if (_introPhase == IntroPhase.Boot)
                {
                    <div class="boot-status">System booting</div>
                }

                @if (_introPhase == IntroPhase.Dialogue || _introPhase == IntroPhase.Commit)
                {
                    <div class="intro-dialogue">
                        <span id="introLine"></span><span class="intro-caret"></span>
                    </div>
                }

                @if (_introPhase == IntroPhase.Naming)
                {
                    <h1 class="intro-title intro-title-late">Age Of LibertY</h1>
                    <div class="intro-dialogue naming-prompt">How do you want to name your City?</div>
                    <div class="name-input-wrap" @onclick:stopPropagation="true">
                        <input class="name-input" type="text" maxlength="24"
                               @bind="State.CityName" @bind:event="oninput"
                               placeholder="Liberty City" />
                    </div>
                    <button class="start-btn" @onclick="IntroCommit" @onclick:stopPropagation="true">
                        <span>LAUNCH SIMULATION</span>
                        <span class="start-arrow">→</span>
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        <div class="game-container">
            <div class="game-fadein"></div>

            @if (_activeTab == Tab.Map)
            {
                <!-- ═══ MAP TAB ═══ -->
                <!-- HUD -->
                <div class="hud">
                    <div class="hud-main-row">
                        <div class="hud-left">
                            <div class="hud-stat" id="hudGold">
                                <span class="hud-emoji">💰</span>
                                <div class="hud-stat-inner">
                                    <div class="hud-num gold-color">$@EconomyEngine.FormatNumber(State.Gold)</div>
                                    <div class="hud-rate">+@EconomyEngine.FormatNumber(Economy.GetIncomeRate())/min</div>
                                </div>
                            </div>
                        </div>
                        <div class="hud-center">
                            <div class="hud-era-name" style="color: @CurrentEra.Color">@CurrentEra.Name</div>
                            <div class="hud-era-sub">Turn @State.Turn</div>
                        </div>
                        <div class="hud-right">
                            <div class="hud-stat" id="hudPop">
                                <span class="hud-emoji">👥</span>
                                <div class="hud-stat-inner">
                                    <div class="hud-num pop-color">@EconomyEngine.FormatNumber(State.Population)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="condition-meters @PressureTone" @onclick="TogglePressureDetails" aria-label="Open city conditions">
                        <span class="condition-meter">
                            <span class="condition-top"><span>Affordability</span><b>@Pressure.AffordabilityLabel</b></span>
                            <span class="condition-track"><span style="@($"width:{Pressure.AffordabilityScore}%")"></span></span>
                        </span>
                        <span class="condition-meter">
                            <span class="condition-top"><span>Growth · 10T</span><b>@GrowthDisplay</b></span>
                            <span class="condition-track"><span style="@($"width:{GrowthScore}%")"></span></span>
                        </span>
                        <span class="condition-meter">
                            <span class="condition-top"><span>Approval</span><b>@Math.Round(State.Approval)</b></span>
                            <span class="condition-track"><span style="@($"width:{Math.Round(State.Approval)}%")"></span></span>
                        </span>
                    </button>
                </div>

                @if (CurrentEraGoals.Count > 0)
                {
                    <section class="era-goals @(_goalsOpen ? "open" : "")">
                        <button type="button" class="era-goals-head" @onclick="() => _goalsOpen = !_goalsOpen">
                            <span>Era goals</span>
                            <span class="era-goal-dots">
                                @foreach (var goal in CurrentEraGoals)
                                {
                                    <i class="@(goal.Completed ? "done" : "")"></i>
                                }
                            </span>
                            <b>@CompletedEraGoals/3</b><span class="era-goals-caret">⌄</span>
                        </button>
                        <div class="era-goals-body">
                            @foreach (var goal in CurrentEraGoals)
                            {
                                var goalPercent = Math.Clamp(goal.Progress / Math.Max(1, goal.Target) * 100, 0, 100);
                                <div class="era-goal @(goal.Completed ? "done" : "")">
                                    <div><span>@(goal.Completed ? "✓" : "○")</span><strong>@goal.Title</strong><small>@GoalProgress(goal)</small></div>
                                    <div class="era-goal-track"><span style="@($"width:{goalPercent:0.#}%")"></span></div>
                                </div>
                            }
                            <div class="era-goals-reward">Complete all three · <b>+$@EconomyEngine.FormatNumber(Pressure.GoalReward(GatedEraIdx))</b></div>
                        </div>
                    </section>
                }

                @if (_pressureDetailsOpen)
                {
                    <div class="city-pressure-scrim" @onclick="TogglePressureDetails"></div>
                    <section class="city-pressure-sheet" role="dialog" aria-modal="true" aria-label="Cost of living basket">
                        <div class="city-pressure-handle"></div>
                        <div class="city-pressure-head"><div><small>Citizen needs</small><h2>@Pressure.AffordabilityLabel</h2></div><button @onclick="TogglePressureDetails">✕</button></div>
                        <p>Household income is compared with the era's essential basket. Build supply before shortages push prices higher.</p>
                        @foreach (var need in Pressure.GetBasket(GatedEraIdx))
                        {
                            var pct = Math.Round(Math.Min(1.35, need.Coverage) * 100);
                            <button class="need-row" disabled="@(need.AtomId == null)" @onclick="() => SelectNeedAtom(need.AtomId)">
                                <span class="need-icon">@need.Icon</span><span class="need-copy"><strong>@need.Label</strong><small>$@EconomyEngine.FormatNumber(need.UnitPrice) · @NeedStatus(need.Coverage)</small></span>
                                <span class="need-coverage @(need.Coverage < .75 ? "critical" : need.Coverage < 1 ? "strained" : "")">@pct%</span>
                            </button>
                        }
                        <div class="city-pressure-note">Coverage below 100% raises demand and living costs. Conditions update once per turn.</div>
                    </section>
                }

                <!-- Immediate consequence / dispatch detail. The backdrop is
                     intentionally inert: only the card dismisses itself. -->
                @if (ActiveDispatch is GameDispatch activeDispatch)
                {
                    <div class="overlay feedback-overlay" role="dialog" aria-modal="true" aria-label="@DispatchLabel(activeDispatch)">
                        <button type="button" class="feedback-modal consequence-card"
                                @onclick="DismissFeedback" @onclick:stopPropagation="true">
                            <div class="consequence-choice">
                                <div class="consequence-label">@DispatchLabel(activeDispatch) · Turn @activeDispatch.EventTurn</div>
                                <div class="consequence-cause">@activeDispatch.Cause</div>
                            </div>
                            @if (activeDispatch.DisplayPriceChanges.Count > 0)
                            {
                                <div class="consequence-section-label">Cost changes</div>
                                <div class="consequence-prices">
                                    @foreach (var change in activeDispatch.DisplayPriceChanges.Take(3))
                                    {
                                        var atom = Config.AtomsById.GetValueOrDefault(change.AtomId);
                                        var wentUp = change.PercentChange > 0;
                                        <div class="consequence-price @(wentUp ? "up" : "down")">
                                            <div class="consequence-price-icon">@(atom?.Icon ?? "◆")</div>
                                            <div class="consequence-price-name">@(atom?.Name ?? "Price")</div>
                                            <div class="consequence-price-delta">@(wentUp ? "▲" : "▼")@Math.Abs(change.PercentChange).ToString("0.#")%</div>
                                            <div class="consequence-price-values"><s>$@EconomyEngine.FormatNumber(change.OldPrice)</s> → $@EconomyEngine.FormatNumber(change.NewPrice)</div>
                                        </div>
                                    }
                                </div>
                                @if (activeDispatch.DisplayPriceChanges.Count > 3)
                                {
                                    <div class="consequence-more">+@(activeDispatch.DisplayPriceChanges.Count - 3) more changes in Dispatches</div>
                                }
                            }
                            <div class="feedback-text">@activeDispatch.DisplayOutcome</div>
                            @if (activeDispatch.IsPending && activeDispatch.TriggerTurn is int triggerTurn)
                            {
                                <div class="consequence-pending">⌛ Further effects may unfold in @Math.Max(0, triggerTurn - State.Turn) turns.</div>
                            }
                            <div class="feedback-hint">tap to continue</div>
                        </button>
                    </div>
                }

                @if (ToastDispatch is GameDispatch toastDispatch)
                {
                    <button type="button" class="dispatch-toast" aria-live="polite" @onclick="() => OpenDispatchDetail(toastDispatch.Id)">
                        <span class="dispatch-toast-icon">@DispatchIcon(toastDispatch)</span>
                        <span>
                            <span class="dispatch-toast-title">@toastDispatch.Title</span>
                            <span class="dispatch-toast-copy">Turn @toastDispatch.EventTurn · tap to review</span>
                        </span>
                    </button>
                }

                <!-- ═══ TUTORIAL: the engine walks the observer through ═══ -->
                @if (_tutorialActive && _tutStep >= 0)
                {
                    var tut = TutSteps[_tutStep];
                    @if (!tut.WaitDrawer && !State.DrawerOpen)
                    {
                        <div class="tut-scrim" @onclick="TutTap"></div>
                    }
                    <button class="intro-skip tut-skip" @onclick="FinishTutorial">SKIP ›</button>
                    <div class="tut-modal @(tut.Top ? "tut-top" : "tut-bottom")" @onclick="TutTap">
                        <span class="bracket tl"></span><span class="bracket tr"></span>
                        <span class="bracket bl"></span><span class="bracket br"></span>
                        <canvas id="tutCanvas" class="tut-canvas"></canvas>
                        <div class="tut-body">
                            <div class="tut-text"><span id="tutLine"></span><span class="intro-caret tut-caret"></span></div>
                            @if (!tut.WaitDrawer)
                            {
                                <div class="feedback-hint">tap to continue</div>
                            }
                        </div>
                    </div>
                }

                <!-- ═══ UNIFIED ERA + CHEST OVERLAY ═══ -->
                @if ((State.EraUnlockAnimIndex is int eraIdx && EraCeremonyAllowed(eraIdx)) || _eraRevealPhase != EraRevealPhase.None)
                {
                    var showingEraIdx = _eraRevealPhase == EraRevealPhase.ChestReveal
                        ? _eraRevealEraIdx
                        : (State.EraUnlockAnimIndex ?? -1);

                    <div class="overlay era-unlock-overlay" @onclick="OnEraOverlayTap">

                        <!-- Shared 3D canvas — persists through both phases -->
                        <div id="eraChestCanvas" class="era-3d-canvas"></div>

                        @if ((_eraRevealPhase == EraRevealPhase.None || _eraRevealPhase == EraRevealPhase.Announcement) && showingEraIdx >= 0 && showingEraIdx < Config.Eras.Count)
                        {
                            <!-- Phase 1: Era Announcement -->
                            var eraData = Config.Eras[showingEraIdx];
                            <div class="era-unlock-top">
                                <div class="era-unlock-label">New Era Unlocked</div>
                                <div class="era-unlock-name">@eraData.Name</div>
                            </div>

                            <div class="era-unlock-bottom">
                                <!-- Era summary stat cards -->
                                <div class="chest-cards" style="margin-bottom:22px;">
                                    <div class="atom-reveal-card era-stat-card" id="eraStatCard_0">
                                        <span class="atom-reveal-icon">⏱️</span>
                                        <span class="era-stat-value">@_ceremonyTime</span>
                                        <span class="era-stat-label">Time in era</span>
                                    </div>
                                    <div class="atom-reveal-card era-stat-card" id="eraStatCard_1">
                                        <span class="atom-reveal-icon">💰</span>
                                        <span class="era-stat-value">$@EconomyEngine.FormatNumber(State.Gold)</span>
                                        <span class="era-stat-label">Treasury</span>
                                    </div>
                                    <div class="atom-reveal-card era-stat-card" id="eraStatCard_2">
                                        <span class="atom-reveal-icon">👥</span>
                                        <span class="era-stat-value">+@_ceremonyCitizens</span>
                                        <span class="era-stat-label">Citizens gained</span>
                                    </div>
                                </div>
                                <div class="era-unlock-tap">Tap to continue</div>
                            </div>
                        }

                        @if (_eraRevealPhase == EraRevealPhase.Address && showingEraIdx >= 0 && showingEraIdx < Config.Eras.Count)
                        {
                            <!-- Phase 1.5: The Engine's Era Address -->
                            var addrEra = Config.Eras[showingEraIdx];
                            <button class="intro-skip" @onclick="SkipCeremony" @onclick:stopPropagation="true">SKIP ›</button>
                            <div class="era-address-tint" style="background: radial-gradient(ellipse 110% 70% at 50% 28%, @(addrEra.Color)44 0%, rgba(4,7,13,0) 58%), linear-gradient(180deg, rgba(4,7,13,0.35) 0%, rgba(4,7,13,0.9) 82%);"></div>

                            <div class="era-unlock-top">
                                <div class="era-unlock-name">@addrEra.Name</div>
                            </div>

                            <div class="era-address-dialogue">
                                <span id="eraAddressLine"></span><span class="intro-caret"></span>
                            </div>

                            <div class="era-unlock-bottom">
                                <div class="era-unlock-tap">Tap to continue</div>
                            </div>
                        }

                        @if (_eraRevealPhase == EraRevealPhase.ChestReveal && _eraRevealEraIdx >= 0 && _eraRevealEraIdx < Config.Eras.Count)
                        {
                            <!-- Phase 2: Chest Reveal with Atom Cards -->
                            var chestEra = Config.Eras[_eraRevealEraIdx];
                            var newAtoms = Config.Atoms.Where(a => a.EraId == chestEra.Id).ToList();

                            <div class="era-unlock-top" style="padding-top:40px;">
                                <div class="era-unlock-label">@chestEra.Name</div>
                                <div class="era-unlock-name" style="font-size:24px;">New Resources</div>
                            </div>

                            <!-- Atom cards overlaid on the 3D scene -->
                            <div class="chest-cards">
                                @for (var i = 0; i < newAtoms.Count; i++)
                                {
                                    var atom = newAtoms[i];
                                    <div class="atom-reveal-card" id="atomCard_@i">
                                        <span class="atom-reveal-icon">@atom.Icon</span>
                                        <div class="atom-reveal-row">
                                            <span class="atom-reveal-name">@atom.Name</span>
                                            <span class="atom-reveal-price">$@atom.BasePrice</span>
                                        </div>
                                    </div>
                                }
                            </div>

                            <button class="chest-continue" id="chestContinueBtn" @onclick="DismissChest" @onclick:stopPropagation="true">
                                START BUILDING →
                            </button>
                        }
                    </div>
                }

                <!-- Scenario modal -->
                @if (State.Phase == GamePhase.Scenario && State.ActiveScenario is Scenario s)
                {
                    var character = Config.CharsById.GetValueOrDefault(s.CharacterId);
                    var choices = Config.GetChoices(s.Id);
                    <div class="overlay">
                        <div class="scenario-stack">
                            @if (character != null)
                            {
                                <div class="char-bubble-anchor">
                                    <div class="char-bubble">
                                        <div class="char-bubble-who"><span class="bubble-who-name">@character.Name</span><span class="bubble-who-role"> · @character.Role</span></div>
                                        @if (!string.IsNullOrWhiteSpace(s.CharacterLine))
                                        {
                                            <span id="charLine"></span><span class="intro-caret char-caret"></span>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="scenario-card">
                                <span class="bracket tl"></span><span class="bracket tr"></span>
                                <span class="bracket bl"></span><span class="bracket br"></span>
                                <div class="scanline"></div>
                                <button class="scenario-close" @onclick="DismissIssue">✕</button>
                                <div class="scenario-head">
                                    <div class="char-hex">
                                        @if (!string.IsNullOrWhiteSpace(character?.PortraitAsset))
                                        {
                                            <img src="assets/characters/@character.PortraitAsset" alt="" decoding="async" />
                                        }
                                        else
                                        {
                                            <span class="char-hex-emoji">@(character?.Icon ?? "❓")</span>
                                        }
                                    </div>
                                    <div class="scenario-title-stack">
                                        <div class="scenario-kicker">New Issue</div>
                                        <div class="scenario-title">@s.Title</div>
                                    </div>
                                </div>
                                <p class="scenario-text">@s.Text.Replace("{cityName}", State.CityName)</p>
                                <div class="scenario-choices">
                                    @foreach (var choice in choices)
                                    {
                                        var cid = choice.Id;
                                        <button class="choice-btn" @onclick="() => HandleChoice(cid)">
                                            @choice.Label
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Stock View overlay -->
                @if (_stockViewAtomId is int svId && Config.AtomsById.TryGetValue(svId, out var svAtom))
                {
                    var svHistory = State.PriceHistory;
                    var svPrices = GetPaddedPrices(svId, svAtom.BasePrice);
                    var ghostPrices = BuildGhostSeries(svId, svPrices, svHistory.Count);
                    if (svPrices.Count >= 2)
                    {
                        var compPrices = _compareAtomId.HasValue ? svHistory.Select(h => h.Prices.GetValueOrDefault(_compareAtomId.Value, 0)).ToList() : new List<int>();
                        var allVals = svPrices.Concat(compPrices).Concat(ghostPrices).Where(v => v > 0).ToList();
                        var svMin = Math.Max(0, allVals.Min() - 1); var svMax = allVals.Max() + 1; var svRange = Math.Max(svMax - svMin, 1);
                        var svFirst = svPrices[0]; var svLast = svPrices[^1];
                        var svTrend = svLast > svFirst ? "#4ae08a" : svLast < svFirst ? "#ff5648" : "#6a7a94";
                        var svPct = svFirst > 0 ? (int)Math.Round(((double)(svLast - svFirst) / svFirst) * 100) : 0;
                        var W = 580; var H = 260; var padX = 46; var padY = 28; var padBot = 36;
                        var chartW = W - padX * 2; var chartH = H - padY - padBot;

                        // Coordinate helpers (inline lambdas, not local functions)
                        var svCount = svPrices.Count;
                        Func<int, double> txd = i => (double)padX + (double)i / Math.Max(1, svCount - 1) * chartW;
                        Func<int, double> tyd = v => (double)padY + (1.0 - (double)(v - svMin) / svRange) * chartH;
                        Func<int, string> tx = i => txd(i).ToString("F1");
                        Func<int, string> ty = v => tyd(v).ToString("F1");

                        var mainPath = BuildSmoothPath(svPrices, padX, chartW, padY, chartH, svMin, svRange, svCount);
                        var ghostPath = ghostPrices.Count >= 2 ? BuildSmoothPath(ghostPrices, padX, chartW, padY, chartH, svMin, svRange, svCount) : "";
                        var mainFillPath = mainPath + $" L {txd(svPrices.Count - 1):F1},{padY + chartH} L {padX},{padY + chartH} Z";

                        var compPath = "";
                        var compFillPath = "";
                        var compColor = "#4a9ade";
                        if (_compareAtomId.HasValue && compPrices.Count >= 2)
                        {
                            compPath = BuildSmoothPath(compPrices, padX, chartW, padY, chartH, svMin, svRange, compPrices.Count);
                            compFillPath = compPath + $" L {txd(compPrices.Count - 1):F1},{padY + chartH} L {padX},{padY + chartH} Z";
                        }

                        // Grid
                        var gridStep = svRange / 4.0;
                        var vGridCount = Math.Min(6, svPrices.Count);
                        var vGridStep = Math.Max(1, svPrices.Count / vGridCount);

                        // Decision event markers — tappable, with this atom's multiplier
                        var choiceEvents = State.ChoiceEvents ?? new List<ChoiceEvent>();
                        var eventMarkers = new List<MarkerInfo>();
                        foreach (var ev in choiceEvents.Where(e => e.Turn >= 1 && e.Turn <= svPrices.Count))
                        {
                            double? evMult = null; string? evLu = null, evLl = null;
                            if (ev.ChoiceId != 0)
                            {
                                var evCh = Config.Choices.FirstOrDefault(x => x.Id == ev.ChoiceId);
                                if (evCh != null)
                                {
                                    var (evImm, evDel) = Config.GetEffects(ev.ChoiceId);
                                    double m = 1; bool any = false;
                                    foreach (var e in evImm.Concat(evDel).Where(e => e.AtomId == svId)) { m *= e.Multiplier; any = true; }
                                    if (any) evMult = m;
                                    evLu = evCh.LearnUrl; evLl = evCh.LearnLabel;
                                }
                            }
                            eventMarkers.Add(new MarkerInfo { Turn = ev.Turn, Label = ev.Label, Mult = evMult, X = txd(Math.Min(ev.Turn - 1, svPrices.Count - 1)), LearnUrl = evLu, LearnLabel = evLl });
                        }

                        // Only unlocked atoms for comparison
                        var comparables = AvailableAtoms.Where(a => a.Id != svId).ToList();

                        <div class="overlay" @onclick="CloseStockView">
                            <div class="stock-card" @onclick:stopPropagation="true">
                                <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
                                    <div style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;background:var(--orange-pale);border:2px solid var(--border);border-radius:var(--r-md);">
                                        <span style="font-size:24px;">@svAtom.Icon</span>
                                    </div>
                                    <div style="flex:1;">
                                        <div style="font-size:18px;font-weight:900;color:var(--text-dark);">@svAtom.Name</div>
                                        <div style="display:flex;align-items:baseline;gap:6px;">
                                            <span style="font-size:20px;font-weight:800;color:@svTrend;">$@svLast</span>
                                            <span style="font-size:13px;font-weight:700;color:@svTrend;background:@(svLast >= svFirst ? "var(--green-pale)" : "var(--red-pale)");padding:2px 8px;border-radius:var(--r-full);">@(svPct >= 0 ? "▲" : "▼") @Math.Abs(svPct)%</span>
                                        </div>
                                    </div>
                                    <button class="stock-close" @onclick="CloseStockView">✕</button>
                                </div>

                                <div class="stock-chart-wrap">
                                    <svg viewBox="0 0 @W @H" style="width:100%;height:auto;display:block;overflow:visible;">
                                        <defs>
                                            <linearGradient id="sv-fill-main" x1="0" y1="0" x2="0" y2="1">
                                                <stop offset="0%" stop-color="@svTrend" stop-opacity="0.2" />
                                                <stop offset="100%" stop-color="@svTrend" stop-opacity="0.02" />
                                            </linearGradient>
                                            @if (!string.IsNullOrEmpty(compPath))
                                            {
                                                <linearGradient id="sv-fill-comp" x1="0" y1="0" x2="0" y2="1">
                                                    <stop offset="0%" stop-color="@compColor" stop-opacity="0.12" />
                                                    <stop offset="100%" stop-color="@compColor" stop-opacity="0.01" />
                                                </linearGradient>
                                            }
                                        </defs>

                                        @for (int g = 0; g <= 4; g++)
                                        {
                                            var gVal = (int)(svMin + g * gridStep);
                                            var gY = tyd(gVal);
                                            <line x1="@padX" y1="@gY.ToString("F1")" x2="@(W - padX)" y2="@gY.ToString("F1")"
                                                  stroke="var(--border)" stroke-width="0.5" stroke-dasharray="3,3" opacity="0.5" />
                                            @((MarkupString)$"<text x=\"{padX - 6}\" y=\"{gY + 3:F1}\" text-anchor=\"end\" font-size=\"9\" fill=\"#6a7a94\" font-family=\"'JetBrains Mono', monospace\">${gVal}</text>")
                                        }

                                        @for (int vg = 0; vg <= vGridCount; vg++)
                                        {
                                            var vIdx = Math.Min(vg * vGridStep, svPrices.Count - 1);
                                            var vx = txd(vIdx);
                                            <line x1="@vx.ToString("F1")" y1="@padY" x2="@vx.ToString("F1")" y2="@(padY + chartH)"
                                                  stroke="var(--border)" stroke-width="0.5" stroke-dasharray="3,3" opacity="0.3" />
                                            @((MarkupString)$"<text x=\"{vx:F1}\" y=\"{padY + chartH + 14}\" text-anchor=\"middle\" font-size=\"9\" fill=\"#6a7a94\" font-family=\"'JetBrains Mono', monospace\">T{vIdx + 1}</text>")
                                        }

                                        @foreach (var em in eventMarkers)
                                        {
                                            var mk = em;
                                            var hit = mk.Mult.HasValue;
                                            <line x1="@mk.X.ToString("F1")" y1="@padY" x2="@mk.X.ToString("F1")" y2="@(padY + chartH)"
                                                  stroke="var(--orange)" stroke-width="1" stroke-dasharray="4,3" opacity="@(hit ? "0.55" : "0.18")" />
                                            <g style="cursor:pointer;" @onclick="() => _selectedMarker = mk" @onclick:stopPropagation="true">
                                                <circle cx="@mk.X.ToString("F1")" cy="@padY" r="18" fill="transparent" />
                                                @if (hit)
                                                {
                                                    <circle cx="@mk.X.ToString("F1")" cy="@padY" r="11" fill="none" stroke="var(--orange)" stroke-width="1" opacity="0.35" class="chart-marker-halo" />
                                                }
                                                <circle cx="@mk.X.ToString("F1")" cy="@padY" r="@(hit ? 6.5 : 3)" fill="var(--orange)" opacity="@(hit ? "0.95" : "0.35")"
                                                        class="@(hit ? "chart-marker-pulse" : "")" />
                                            </g>
                                            @if (hit)
                                            {
                                                @((MarkupString)$"<text x=\"{mk.X + 7:F1}\" y=\"{padY + 10}\" font-size=\"8\" fill=\"#d4a843\" font-family=\"'Rajdhani', sans-serif\" font-weight=\"700\" opacity=\"0.75\">{(mk.Label.Length > 16 ? mk.Label.Substring(0, 16) + "…" : mk.Label)}</text>")
                                            }
                                        }

                                        @if (!string.IsNullOrEmpty(ghostPath))
                                        {
                                            <path d="@ghostPath" fill="none" stroke="#8aa4c8" stroke-width="1.5"
                                                  stroke-dasharray="5,4" stroke-linecap="round" opacity="0.55" />
                                            @((MarkupString)$"<text x=\"{W - padX}\" y=\"{tyd(ghostPrices[^1]) - 7:F1}\" text-anchor=\"end\" font-size=\"8\" fill=\"#8aa4c8\" font-family=\"'Rajdhani', sans-serif\" font-weight=\"700\" letter-spacing=\"2\" opacity=\"0.8\">THE UNSEEN</text>")
                                        }

                                        @if (!string.IsNullOrEmpty(compPath))
                                        {
                                            <path d="@compFillPath" fill="url(#sv-fill-comp)" />
                                            <path d="@compPath" fill="none" stroke="@compColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.7" />
                                        }

                                        <path d="@mainFillPath" fill="url(#sv-fill-main)" />
                                        <path d="@mainPath" fill="none" stroke="@svTrend" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                                        <circle cx="@tx(svPrices.Count - 1)" cy="@ty(svLast)" r="4.5" fill="@svTrend" stroke="var(--bg-card)" stroke-width="2" />
                                        <circle cx="@tx(0)" cy="@ty(svFirst)" r="3" fill="@svTrend" opacity="0.5" />
                                    </svg>
                                </div>

                                @if (_selectedMarker is MarkerInfo selMk)
                                {
                                    <div class="marker-info">
                                        <div style="flex:1;min-width:0;">
                                            <div class="marker-info-title">T@(selMk.Turn) · @selMk.Label</div>
                                            <div class="marker-info-sub">@(selMk.Mult is double selMult ? $"×{selMult:0.##} on {svAtom.Name}" : "No direct effect on this good")</div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(selMk.LearnUrl))
                                        {
                                            <button class="learn-btn" @onclick="() => OpenLearnUrl(selMk.LearnUrl)">⌕ @(string.IsNullOrWhiteSpace(selMk.LearnLabel) ? "Learn why" : selMk.LearnLabel)</button>
                                        }
                                        <button class="stock-close" style="width:28px;height:28px;flex-shrink:0;" @onclick="() => _selectedMarker = null">✕</button>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(ghostPath))
                                {
                                    <div class="unseen-caption">The dashed line is the timeline without your decisions.</div>
                                }

                                @if (_compareAtomId.HasValue && Config.AtomsById.TryGetValue(_compareAtomId.Value, out var compAtom))
                                {
                                    <div style="display:flex;gap:16px;padding:6px 4px 10px;font-size:11px;font-weight:700;">
                                        <div style="display:flex;align-items:center;gap:5px;">
                                            <div style="width:12px;height:3px;border-radius:2px;background:@svTrend;"></div>
                                            <span style="color:var(--text-muted);">@svAtom.Name</span>
                                        </div>
                                        <div style="display:flex;align-items:center;gap:5px;">
                                            <div style="width:12px;height:3px;border-radius:2px;background:@compColor;"></div>
                                            <span style="color:var(--text-muted);">@compAtom.Name</span>
                                            <button style="background:none;border:none;color:var(--red);cursor:pointer;font-size:12px;font-weight:800;padding:0 4px;" @onclick="() => _compareAtomId = null">✕</button>
                                        </div>
                                    </div>
                                }

                                <div class="stock-compare">
                                    <div style="font-size:10px;color:var(--text-muted);letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;font-weight:800;">COMPARE WITH</div>
                                    <div class="stock-compare-grid">
                                        @foreach (var ca2 in comparables)
                                        {
                                            var cId = ca2.Id;
                                            <button class="stock-compare-chip @(_compareAtomId == cId ? "active" : "")"
                                                    @onclick="() => _compareAtomId = _compareAtomId == cId ? null : cId">
                                                <span style="font-size:14px;">@ca2.Icon</span>
                                                <span style="font-size:10px;">@ca2.Name</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }

                <!-- ATOM GRAPH -->
                <div class="graph-area" id="graphArea">
                    <div class="graph-glow"></div>
                    <svg viewBox="0 0 660 @MapH" preserveAspectRatio="xMidYMin meet" class="atom-svg" id="atomSvg"
                         style="transform: translate(@(_panX)px, @(_panY)px) scale(@_zoom); transform-origin: center top; cursor: grab;">
                        <defs>
                            <filter id="glow"><feGaussianBlur stdDeviation="4" result="g" /><feMerge><feMergeNode in="g" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
                            <filter id="softglow"><feGaussianBlur stdDeviation="6" result="g" /><feMerge><feMergeNode in="g" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
                            <linearGradient id="eraBands" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0" stop-color="@Config.Eras[0].Color" stop-opacity="0" />
                                @for (int ei = 0; ei < VisibleBands; ei++)
                                {
                                    var off = ((ei * BandH + BandH / 2.0) / MapH).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
                                    <stop offset="@off" stop-color="@Config.Eras[ei].Color" stop-opacity="0.13" />
                                }
                                <stop offset="1" stop-color="@Config.Eras[Math.Max(0, VisibleBands - 1)].Color" stop-opacity="0" />
                            </linearGradient>
                            <linearGradient id="edgeFadeX" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0" stop-color="#fff" stop-opacity="0" />
                                <stop offset="0.12" stop-color="#fff" stop-opacity="1" />
                                <stop offset="0.88" stop-color="#fff" stop-opacity="1" />
                                <stop offset="1" stop-color="#fff" stop-opacity="0" />
                            </linearGradient>
                            <mask id="eraBandMask">
                                <rect x="0" y="0" width="660" height="@MapH" fill="url(#edgeFadeX)" />
                            </mask>
                        </defs>

                        <!-- Era light: one continuous gradient, colors cross-fading between eras -->
                        <rect class="era-glow" x="0" y="0" width="660" height="@MapH"
                              fill="url(#eraBands)" mask="url(#eraBandMask)" pointer-events="none" />

                        <!-- Edges -->
                        @foreach (var atom in AvailableAtoms)
                        {
                            var deps = Config.GetDependencies(atom.Id);
                            foreach (var dep in deps)
                            {
                                if (!Config.AtomsById.TryGetValue(dep.RequiresAtomId, out var reqAtom)) continue;
                                if (!AvailableAtoms.Contains(reqAtom)) continue;
                                var isCasc = State.Cascading.GetValueOrDefault(atom.Id) || State.Cascading.GetValueOrDefault(reqAtom.Id);
                                var isSel = State.SelectedAtomId == atom.Id;
                                var isBuilt = State.GetBuiltCount(atom.Id) > 0;
                                <line x1="@reqAtom.PositionX" y1="@RY(reqAtom)"
                                      x2="@atom.PositionX" y2="@RY(atom)"
                                      stroke="@(isCasc ? "#ff5648" : isSel ? "#d4a843" : isBuilt ? "#4a6288" : "rgba(96,150,200,0.35)")"
                                      stroke-width="@(isCasc ? "3" : isSel ? "2.5" : isBuilt ? "1.5" : "0.7")"
                                      filter="@(isCasc ? "url(#glow)" : "none")"
                                      opacity="@(isBuilt ? "0.9" : "0.35")" />
                            }
                        }

                        <!-- Nodes -->
                        @foreach (var atom in AvailableAtoms)
                        {
                            var isCasc = State.Cascading.GetValueOrDefault(atom.Id);
                            var isSel = State.SelectedAtomId == atom.Id;
                            var count = State.GetBuiltCount(atom.Id);
                            var price = State.GetPrice(atom);
                            var eraColor = Config.ErasById.GetValueOrDefault(atom.EraId)?.Color ?? "#3a5070";
                            var r = isSel ? 54 : 48;

                            <g data-node @onclick="() => SelectAtom(atom.Id)" style="cursor: pointer;">
                                @if (count > 0)
                                {
                                    <polygon points="@HexPts(atom.PositionX, RY(atom), 64)"
                                             fill="none" stroke="@eraColor" stroke-width="1" opacity="0.2" class="breathe" />
                                }
                                <polygon points="@HexPts(atom.PositionX, RY(atom), r)"
                                         fill="@(isCasc ? "rgba(255,86,72,0.08)" : isSel ? "rgba(212,160,32,0.08)" : count > 0 ? "rgba(12,26,46,0.92)" : "rgba(10,22,38,0.85)")"
                                         stroke="@(isCasc ? "#ff5648" : isSel ? "#d4a843" : count > 0 ? eraColor : "rgba(96,150,200,0.4)")"
                                         stroke-width="@(isCasc ? "2.5" : isSel ? "2.5" : count > 0 ? "1.8" : "1")"
                                         filter="@(isCasc ? "url(#glow)" : isSel ? "url(#softglow)" : "none")" />
                                @if (!string.IsNullOrWhiteSpace(atom.SpriteAsset))
                                {
                                    <image href="@("assets/atoms/" + atom.SpriteAsset)" x="@(atom.PositionX - 49)" y="@(RY(atom) - 57)" width="92" height="92" />
                                }
                                else
                                {
                                    @((MarkupString)$"<text x=\"{atom.PositionX}\" y=\"{RY(atom)}\" text-anchor=\"middle\" font-size=\"34\" dominant-baseline=\"central\">{atom.Icon}</text>")
                                }
                                @((MarkupString)$"<text x=\"{atom.PositionX}\" y=\"{RY(atom) + 62}\" text-anchor=\"middle\" font-size=\"15\" fill=\"{(isCasc ? "#ff5648" : "#9ab4d4")}\" font-family=\"'Rajdhani', sans-serif\" font-weight=\"600\" letter-spacing=\"1\">{atom.Name}</text>")
                                @((MarkupString)$"<text x=\"{atom.PositionX}\" y=\"{RY(atom) + 78}\" text-anchor=\"middle\" font-size=\"12\" fill=\"{(isCasc ? "#ff5648" : "#6a7a94")}\" font-family=\"'JetBrains Mono', monospace\">${EconomyEngine.FormatNumber(price)}</text>")
                                @if (count > 0)
                                {
                                    <rect x="@(atom.PositionX + 30)" y="@(RY(atom) - 42)" width="28" height="18" rx="2" fill="#d4a020" opacity="0.95" />
                                    @((MarkupString)$"<text x=\"{atom.PositionX + 44}\" y=\"{RY(atom) - 33}\" text-anchor=\"middle\" dominant-baseline=\"central\" font-size=\"11\" fill=\"#1a1408\" font-family=\"'JetBrains Mono', monospace\" font-weight=\"700\">×{count}</text>")
                                }
                                @if (atom.PopGain > 0 && count > 0)
                                {
                                    <rect x="@(atom.PositionX - 58)" y="@(RY(atom) - 42)" width="36" height="18" rx="2" fill="#3e5a80" opacity="0.9" />
                                    @((MarkupString)$"<text x=\"{atom.PositionX - 40}\" y=\"{RY(atom) - 33}\" text-anchor=\"middle\" dominant-baseline=\"central\" font-size=\"11\" fill=\"#cfe2ff\" font-family=\"'JetBrains Mono', monospace\" font-weight=\"600\">+{atom.PopGain}</text>")
                                }
                            </g>
                        }
                    </svg>
                </div>

                <!-- BOTTOM DRAWER -->
                @if (State.DrawerOpen && SelectedAtom is Atom sel)
                {
                    var deps = Config.GetDependencies(sel.Id);
                    var cost = State.GetBuildCost(sel, Config);
                    var canBuild = State.Gold >= cost && (deps.Count > 0 || sel.PopGain > 0);

                    <div class="drawer-scrim" @onclick="CloseDrawer"></div>
                    <div class="drawer open">
                        <div class="drawer-handle" @onclick="CloseDrawer" @ontouchstart="DrawerTouchStart" @ontouchmove="DrawerTouchMove"><div class="drawer-pill"></div></div>
                        <div class="drawer-content">
                            <div class="drawer-header" @ontouchstart="DrawerTouchStart" @ontouchmove="DrawerTouchMove">
                                <span class="drawer-icon">@sel.Icon</span>
                                <div>
                                    <div class="drawer-title">@sel.Name</div>
                                    <div class="drawer-meta">
                                        @if (sel.PopGain > 0)
                                        {
                                            <span class="pop-tag">+@sel.PopGain pop</span>
                                        }
                                        @if (State.GetBuiltCount(sel.Id) > 0)
                                        {
                                            <span class="built-tag">Built ×@State.GetBuiltCount(sel.Id)</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (deps.Count > 0)
                            {
                                <div class="deps-grid">
                                    @foreach (var dep in deps)
                                    {
                                        if (!Config.AtomsById.TryGetValue(dep.RequiresAtomId, out var reqAtom)) continue;
                                        var depPrice = State.GetPrice(reqAtom);
                                        <div class="dep-chip">
                                            <span class="dep-emoji">@reqAtom.Icon</span>
                                            <div>
                                                <div class="dep-name">@reqAtom.Name ×@dep.Quantity</div>
                                                <div class="dep-cost">$@EconomyEngine.FormatNumber(depPrice * dep.Quantity)</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="dep-chip" style="justify-content:center">
                                    <span class="dep-cost">Base resource · $@EconomyEngine.FormatNumber(State.GetPrice(sel))</span>
                                </div>
                            }

                            <!-- Sparkline -->
                            <div class="sparkline-wrap" @onclick="() => OpenStockView(sel.Id)">
                                @{
                                    var spPrices = GetPaddedPrices(sel.Id, sel.BasePrice);
                                    var spMin = spPrices.Min(); var spMax = spPrices.Max(); var spRange = Math.Max(spMax - spMin, 1);
                                    var spFirst = spPrices[0]; var spLast = spPrices[^1];
                                    var spTrend = spLast > spFirst ? "#4ae08a" : spLast < spFirst ? "#ff5648" : "#6a7a94";
                                    var spPct = spFirst > 0 ? (int)Math.Round(((double)(spLast - spFirst) / spFirst) * 100) : 0;
                                    var spW = 200.0; var spH = 40.0; var spPad = 4.0;
                                    var spPath = BuildSmoothPath(spPrices, 0, spW, spPad, spH - spPad * 2, spMin, spRange, spPrices.Count);
                                    var spFillPath = spPath + $" L {spW:F1},{spH} L 0,{spH} Z";
                                }
                                <div class="sparkline-header">
                                    <span class="sparkline-label">PRICE HISTORY</span>
                                    <span style="font-size:11px;color:@spTrend;font-weight:700;">@(spPct >= 0 ? "+" : "")@(spPct)%</span>
                                </div>
                                <svg viewBox="0 0 @spW @spH" style="width:100%;height:40px;display:block;">
                                    <defs>
                                        <linearGradient id="spark-fill-@sel.Id" x1="0" y1="0" x2="0" y2="1">
                                            <stop offset="0%" stop-color="@spTrend" stop-opacity="0.2" />
                                            <stop offset="100%" stop-color="@spTrend" stop-opacity="0" />
                                        </linearGradient>
                                    </defs>
                                    <path d="@spFillPath" fill="url(#spark-fill-@sel.Id)" />
                                    <path d="@spPath" fill="none" stroke="@spTrend" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <div class="sparkline-hint">Tap for full chart →</div>
                            </div>

                            @{
                                var anat = GetInfluences(sel.Id, AnatomyWindowTurns).Take(3).ToList();
                            }
                            @if (anat.Count > 0)
                            {
                                <div class="anatomy">
                                    <div class="anatomy-title">Price anatomy</div>
                                    <div class="anatomy-row anatomy-base">
                                        <span class="anatomy-label">Base price</span>
                                        <span class="anatomy-mult">$@sel.BasePrice</span>
                                    </div>
                                    @foreach (var inf in anat)
                                    {
                                        var infLocal = inf;
                                        <div class="anatomy-row">
                                            <span class="anatomy-turn">T@(infLocal.ApplyTurn)</span>
                                            <span class="anatomy-label">@(infLocal.Label.Length > 24 ? infLocal.Label.Substring(0, 24) + "…" : infLocal.Label)@(infLocal.IsDelayed ? " ⏳" : "")</span>
                                            <span class="anatomy-mult @(infLocal.Mult >= 1 ? "up" : "down")">×@infLocal.Mult.ToString("0.##")</span>
                                            @if (!string.IsNullOrWhiteSpace(infLocal.LearnUrl))
                                            {
                                                <button class="learn-btn learn-btn-sm" @onclick="() => OpenLearnUrl(infLocal.LearnUrl)">⌕</button>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <div class="drawer-footer">
                                <div class="total-label">Total: <span class="@(canBuild ? "accent" : "danger")">$@EconomyEngine.FormatNumber(cost)</span></div>
                                @if (deps.Count > 0 || sel.PopGain > 0)
                                {
                                    var buildMax = cost > 0 ? (int)Math.Min(999, State.Gold / cost) : 0;
                                    <div class="build-group">
                                        @if (_buildMenuOpen && buildMax >= 2)
                                        {
                                            <div class="build-menu">
                                                @if (buildMax >= 10)
                                                {
                                                    <button class="build-menu-item" @onclick="() => BuildMany(sel.Id, 10)">Build ×10 · $@EconomyEngine.FormatNumber(cost * 10)</button>
                                                }
                                                <button class="build-menu-item" @onclick="() => BuildMany(sel.Id, buildMax)">Build Max ×@buildMax · $@EconomyEngine.FormatNumber(cost * buildMax)</button>
                                            </div>
                                        }
                                        <button class="build-btn build-btn-main" disabled="@(!canBuild)" @onclick="() => BuildAtom(sel.Id)">
                                            @(canBuild ? $"BUILD · ${EconomyEngine.FormatNumber(cost)}" : $"NEED ${EconomyEngine.FormatNumber(cost)}")
                                        </button>
                                        @if (buildMax >= 2)
                                        {
                                            <button class="build-caret @(_buildMenuOpen ? "open" : "")" @onclick="() => _buildMenuOpen = !_buildMenuOpen">▾</button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else if (_activeTab == Tab.City)
            {
                <div class="city-view">
                    @{
                        var cur = CivicIndicators.ComputeAll(State, Config, Economy.GetIncomeRate());
                        var cityIncome = Economy.GetIncomeRate();
                    }
                    <!-- ═══ CIVIC REGISTRY HEADER ═══ -->
                    <div class="civic-header">
                        <div class="civic-kicker">Civic Registry · Turn @State.Turn</div>
                        <div class="civic-name">@State.CityName</div>
                        <div class="civic-era">@CurrentEra.Name</div>
                        <div class="civic-mood">@CivicIndicators.TierLine(CivicIndicators.CivicMood, cur[CivicIndicators.CivicMood])</div>
                    </div>

                    <!-- ═══ STAT STRIP ═══ -->
                    <div class="stat-strip">
                        <div class="strip-item">
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.4" /><path d="M5 20c0-3.9 3.1-7 7-7s7 3.1 7 7" /></svg>
                            <div class="strip-value">@EconomyEngine.FormatNumber(State.Population)</div>
                            <div class="strip-label">Citizens</div>
                        </div>
                        <div class="strip-item">
                            <svg viewBox="0 0 24 24"><ellipse cx="12" cy="6.5" rx="7" ry="3" /><path d="M5 6.5v5c0 1.7 3.1 3 7 3s7-1.3 7-3v-5M5 11.5v5c0 1.7 3.1 3 7 3s7-1.3 7-3v-5" /></svg>
                            <div class="strip-value">$@EconomyEngine.FormatNumber(State.Gold)</div>
                            <div class="strip-label">Treasury</div>
                        </div>
                        <div class="strip-item">
                            <svg viewBox="0 0 24 24"><path d="M4 19 L4 5 M4 19 L20 19" opacity="0.5" /><path d="M7 15 L11 10 L14 12.5 L19 6" /><path d="M19 6 L19 9.5 M19 6 L15.5 6" /></svg>
                            <div class="strip-value">$@EconomyEngine.FormatNumber(cityIncome)</div>
                            <div class="strip-label">Output / turn</div>
                        </div>
                        <div class="strip-item">
                            <svg viewBox="0 0 24 24"><path d="M3 12 L8 12 L10 7 L13 17 L15 12 L21 12" /></svg>
                            <div class="strip-value">@((35 + cur[CivicIndicators.LifeExpectancy] * 0.6).ToString("F0"))<span class="strip-unit">yrs</span></div>
                            <div class="strip-label">Life expect.</div>
                        </div>
                        <div class="strip-item">
                            <svg viewBox="0 0 24 24"><path d="M12 5.5c-2-1.8-6.5-1.8-8 .5v12c1.5-2.3 6-2.3 8-.5 2-1.8 6.5-1.8 8 .5v-12c-1.5-2.3-6-2.3-8-.5z" /><path d="M12 5.5 L12 17.5" /></svg>
                            <div class="strip-value">@cur[CivicIndicators.Education].ToString("F0")</div>
                            <div class="strip-label">Education</div>
                        </div>
                        <div class="strip-item">
                            <svg viewBox="0 0 24 24"><path d="M4 9h9a3 3 0 1 0-3-3M4 14h13a3 3 0 1 1-3 3M4 19h7" /></svg>
                            <div class="strip-value">@cur[CivicIndicators.AirQuality].ToString("F0")</div>
                            <div class="strip-label">Air quality</div>
                        </div>
                    </div>

                    <!-- ═══ CIVIC FINGERPRINT (radar) ═══ -->
                    @{
                        var rAxes = 12; var rcx = 150.0; var rcy = 132.0; var rR = 92.0;
                        var rLbl = new[] { "LIB", "CRM", "LIFE", "AIR", "EDU", "MKT", "PRO", "IND", "BUR", "LAZ", "POL", "DEF" };
                        var youPoly = RadarPoints(rAxes, rcx, rcy, rR, i => cur[i]);
                        var themPoly = RadarPoints(rAxes, rcx, rcy, rR, i => CivicIndicators.SimAvg(i, State.Turn));
                    }
                    <div class="city-section">
                        <div class="section-title">Civic Fingerprint</div>
                        <div class="radar-selected">Selected · <span>@CivicIndicators.Names[_metricSel]</span></div>
                        <svg class="radar" viewBox="0 0 300 276">
                            @for (var ring = 1; ring <= 4; ring++)
                            {
                                var rv = ring * 25.0;
                                <polygon points="@RadarPoints(rAxes, rcx, rcy, rR, _ => rv)" fill="none"
                                         stroke="rgba(120,190,255,@(ring == 4 ? "0.18" : "0.08"))" stroke-width="1" />
                            }
                            @for (var ax = 0; ax < rAxes; ax++)
                            {
                                var cax = ax;
                                var aAng = -Math.PI / 2 + ax * 2 * Math.PI / rAxes;
                                var ax2 = rcx + rR * Math.Cos(aAng); var ay2 = rcy + rR * Math.Sin(aAng);
                                var lx = rcx + (rR + 15) * Math.Cos(aAng); var ly = rcy + (rR + 15) * Math.Sin(aAng) + 3;
                                <line x1="@rcx" y1="@rcy" x2="@ax2.ToString("F1")" y2="@ay2.ToString("F1")" stroke="rgba(120,190,255,0.08)" stroke-width="1" />
                                @((MarkupString)$"<text x=\"{lx:F1}\" y=\"{ly:F1}\" text-anchor=\"middle\" class=\"radar-lbl {(cax == _metricSel ? "on" : "")}\">{rLbl[cax]}</text>")
                            }
                            <polygon points="@themPoly" fill="rgba(160,150,190,0.06)" stroke="rgba(160,150,190,0.55)"
                                     stroke-width="1.4" stroke-dasharray="5 4" />
                            <polygon points="@youPoly" fill="rgba(74,216,255,0.14)" stroke="#4ad8ff" stroke-width="2" stroke-linejoin="round" />
                        </svg>
                        <div class="metrics-legend" style="justify-content:center;">
                            <span><i class="lg-you"></i>@State.CityName</span>
                            <span><i class="lg-them"></i>Other cities</span>
                        </div>
                    </div>

                    <!-- ═══ THE OBSERVATORY: every metric, charted ═══ -->
                    @{
                        var mh = State.IndicatorHistory;
                        var mv = cur[_metricSel];
                        var mAvgNow = CivicIndicators.SimAvg(_metricSel, State.Turn);
                        var mInfl = CivicIndicators.GetInfluences(_metricSel, State, Config);
                    }
                    <div class="city-section">
                        <div class="section-title">The Observatory</div>
                        <div class="metric-chips">
                            @for (var mi = 0; mi < CivicIndicators.Count; mi++)
                            {
                                var cmi = mi;
                                <button class="metric-chip @(mi == _metricSel ? "on" : "")" @onclick="() => SelectMetric(cmi)">@CivicIndicators.Names[mi]</button>
                            }
                        </div>

                        <div class="metrics-hero">
                            <div class="metrics-value">@CivicIndicators.DisplayValue(_metricSel, mv, State, Config)</div>
                            <div class="metrics-grades">
                                <span class="metrics-grade you">@CivicIndicators.Grade(mv)</span>
                                <span class="metrics-grade them">Others · @CivicIndicators.Grade(mAvgNow)</span>
                            </div>
                        </div>
                        <div class="metrics-tier">"@CivicIndicators.TierLine(_metricSel, mv)"</div>

                        @if (mh.Count >= 2)
                        {
                            var mW = 560.0; var mH = 210.0; var mPadX = 10.0; var mPadY = 16.0;
                            var mChartW = mW - mPadX * 2; var mChartH = mH - mPadY * 2;
                            var mCount = mh.Count;
                            Func<int, double> mx = i => mPadX + (double)i / Math.Max(1, mCount - 1) * mChartW;
                            Func<double, double> my = val => mPadY + (1.0 - val / 100.0) * mChartH;
                            var mPts = string.Join(" ", mh.Select((sn, i) => $"{mx(i):F1},{my(sn.V[_metricSel]):F1}"));
                            var mArea = $"M{mx(0):F1},{my(mh[0].V[_metricSel]):F1} " +
                                        string.Join(" ", mh.Select((sn, i) => $"L{mx(i):F1},{my(sn.V[_metricSel]):F1}")) +
                                        $" L{mx(mCount - 1):F1},{mH - mPadY:F1} L{mx(0):F1},{mH - mPadY:F1} Z";
                            var mAvgPts = string.Join(" ", mh.Select((sn, i) => $"{mx(i):F1},{my(CivicIndicators.SimAvg(_metricSel, sn.Turn)):F1}"));
                            var firstTurn = mh[0].Turn; var lastTurn = mh[^1].Turn;
                            var lastX = mx(mCount - 1); var lastY = my(mh[^1].V[_metricSel]);
                            <svg class="metrics-chart obs-chart" viewBox="0 0 560 210" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="obsFill" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="rgba(74,216,255,0.28)" />
                                        <stop offset="100%" stop-color="rgba(74,216,255,0)" />
                                    </linearGradient>
                                </defs>
                                @for (var gy = 0; gy <= 4; gy++)
                                {
                                    <line x1="@mPadX" y1="@my(gy * 25)" x2="@(mW - mPadX)" y2="@my(gy * 25)"
                                          stroke="rgba(120,190,255,0.08)" stroke-width="1" />
                                }
                                <path d="@mArea" fill="url(#obsFill)" />
                                <polyline points="@mAvgPts" fill="none" stroke="rgba(160,150,190,0.5)"
                                          stroke-width="1.5" stroke-dasharray="5 5" />
                                <polyline points="@mPts" fill="none" stroke="#4ad8ff" stroke-width="2.2"
                                          stroke-linejoin="round" stroke-linecap="round" />
                                @if (CivicIndicators.DecisionDriven[_metricSel])
                                {
                                    foreach (var ev in State.ChoiceEvents.Where(e => e.Turn >= firstTurn && e.Turn <= lastTurn))
                                    {
                                        var evIdx = mh.FindIndex(sn => sn.Turn >= ev.Turn);
                                        if (evIdx >= 0)
                                        {
                                            <circle cx="@mx(evIdx)" cy="@my(mh[evIdx].V[_metricSel])" r="4"
                                                    fill="@(ev.FreedomWeight >= 0 ? "#d4a843" : "#ff5648")"
                                                    stroke="#0a1624" stroke-width="1.5" />
                                        }
                                    }
                                }
                                <circle cx="@lastX.ToString("F1")" cy="@lastY.ToString("F1")" r="7" fill="rgba(74,216,255,0.18)" class="obs-pulse" />
                                <circle cx="@lastX.ToString("F1")" cy="@lastY.ToString("F1")" r="3" fill="#4ad8ff" />
                            </svg>
                            <div class="metrics-legend">
                                <span><i class="lg-you"></i>@State.CityName</span>
                                <span><i class="lg-them"></i>Other cities</span>
                                @if (CivicIndicators.DecisionDriven[_metricSel])
                                {
                                    <span><i class="lg-dot"></i>Your decisions</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="metrics-empty">The archive opens next turn — the engine has begun recording.</div>
                        }

                        <div class="metrics-desc">@CivicIndicators.Descriptions[_metricSel]</div>
                        <div class="metrics-infl-title">On the record</div>
                        <div class="metrics-infl">
                            @foreach (var inf in mInfl)
                            {
                                <div class="metrics-infl-row @(inf.Positive ? "pos" : "neg")">
                                    <span class="infl-mark">@(inf.Positive ? "▲" : "▼")</span>
                                    <span>@inf.Text</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Economic Index: the seen and the unseen, aggregated -->
                    @{
                        var (idxSeen, idxGhost) = BuildCityIndex();
                    }
                    @if (idxSeen.Count >= 2)
                    {
                        var iW = 560.0; var iH = 170.0; var iPadX = 40.0; var iPadY = 16.0; var iPadB = 12.0;
                        var iAll = idxSeen.Concat(idxGhost.Count > 0 ? idxGhost : idxSeen).ToList();
                        var iMin = Math.Max(0, iAll.Min() - 1); var iMax = iAll.Max() + 1;
                        var iRange = Math.Max(iMax - iMin, 1);
                        var iChartW = iW - iPadX * 2; var iChartH = iH - iPadY - iPadB;
                        var iSeenPath = BuildSmoothPath(idxSeen, iPadX, iChartW, iPadY, iChartH, iMin, iRange, idxSeen.Count);
                        var iGhostPath = idxGhost.Count >= 2 ? BuildSmoothPath(idxGhost, iPadX, iChartW, iPadY, iChartH, iMin, iRange, idxGhost.Count) : "";

                        <div class="city-section">
                            <div class="section-title">Economic Index</div>
                            <svg viewBox="0 0 @iW @iH" style="width:100%;height:auto;display:block;">
                                @if (!string.IsNullOrEmpty(iGhostPath))
                                {
                                    <path d="@iGhostPath" fill="none" stroke="#8aa4c8" stroke-width="1.5" stroke-dasharray="5,4" stroke-linecap="round" opacity="0.55" />
                                }
                                <path d="@iSeenPath" fill="none" stroke="var(--gold-mid)" stroke-width="2" stroke-linecap="round" />
                            </svg>
                            <div class="index-legend">
                                <span class="index-legend-item"><span class="index-swatch" style="background:var(--gold-mid);"></span>Your timeline</span>
                                @if (!string.IsNullOrEmpty(iGhostPath))
                                {
                                    <span class="index-legend-item"><span class="index-swatch dashed"></span>The unseen</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(iGhostPath))
                            {
                                <div class="unseen-caption" style="padding:6px 0 0;">The dashed line is the economy without your decisions.</div>
                            }
                        </div>
                    }
                    <!--
                    <button class="share-btn" @onclick="ShareCity">SHARE YOUR CITY</button>-->
                    <div class="sfl-credit">A game by <span>Students For Liberty</span></div>
                </div>
            }
            else if (_activeTab == Tab.Badges)
            {
                <!-- ═══ HONORS TAB: the badge collection ═══ -->
                <div class="city-view">
                    <div class="civic-header">
                        <div class="civic-kicker">Hall of Records</div>
                        <div class="civic-name">Honors</div>
                        <div class="civic-era">Construction achievements of @State.CityName</div>
                    </div>

                    <!-- Badge Collection -->
                    <div class="city-card">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
                            <div style="font-size:11px;color:var(--text-muted);letter-spacing:1px;text-transform:uppercase;font-weight:800;">Badges</div>
                            <div style="font-size:11px;color:var(--text-muted);font-weight:700;">
                                @{
                                    var earnedBadges = AvailableAtoms.Count(a => GetBadgeTier(a.Id) > 0);
                                    var totalPossible = AvailableAtoms.Count * 5;
                                }
                                @earnedBadges / @totalPossible
                            </div>
                        </div>
                        <div class="badge-grid">
                            @foreach (var atom in AvailableAtoms)
                            {
                                var tier = GetBadgeTier(atom.Id);
                                var count = State.GetBuiltCount(atom.Id);
                                var nextT = GetNextThreshold(atom.Id);
                                var progress = GetBadgeProgress(atom.Id);
                                var tierColor = BadgeTierColors[tier];
                                var tierBg = BadgeTierBgColors[tier];

                                <div class="badge-item" style="border-color: @(tier > 0 ? tierColor : "var(--border)");">
                                    <div class="badge-icon-wrap" style="background: @(tier > 0 ? tierBg : "var(--bg-card-alt)");">
                                        <span class="badge-atom-icon">@atom.Icon</span>
                                        @if (tier > 0)
                                        {
                                            <span class="badge-tier-dot" style="background: @tierColor;">@BadgeTierEmoji[tier]</span>
                                        }
                                    </div>
                                    <div class="badge-info">
                                        <div class="badge-atom-name">@atom.Name</div>
                                        <div class="badge-count">@count / @nextT</div>
                                        <div class="badge-bar-bg">
                                            <div class="badge-bar-fill" style="width: @((progress * 100).ToString("F0"))%; background: @(tier > 0 ? tierColor : "var(--border-strong)");"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else if (_activeTab == Tab.Settings)
            {
                <!-- ═══ SETTINGS TAB ═══ -->
                <div class="settings-view">
                    <div class="city-card">
                        <div class="settings-section-title">Audio</div>
                        <div class="settings-row">
                            <div class="settings-label">Music</div>
                            <input type="range" class="settings-slider" min="0" max="100" value="@((int)(_musicVolume * 100))"
                                   @oninput="OnMusicVolumeChange" />
                            <span class="settings-val">@((int)(_musicVolume * 100))%</span>
                        </div>
                        <div class="settings-row">
                            <div class="settings-label">Sound effects</div>
                            <input type="range" class="settings-slider" min="0" max="100" value="@((int)(_sfxVolume * 100))"
                                   @oninput="OnSfxVolumeChange" />
                            <span class="settings-val">@((int)(_sfxVolume * 100))%</span>
                        </div>
                    </div>

                    <div class="city-card">
                        <div class="settings-section-title">Notifications</div>
                        <div class="settings-row">
                            <div class="settings-label">Issue reminders</div>
                            <label class="switch">
                                <input type="checkbox" checked="@_notifsEnabled" @onchange="OnNotifsToggle" />
                                <span class="switch-track"><span class="switch-thumb"></span></span>
                            </label>
                        </div>
                        <div class="settings-hint">A quiet notification when a new issue reaches your desk. Off means the simulation waits silently.</div>
                    </div>

                    <!--
                    <div class="city-card">
                        <div class="settings-section-title">About</div>
                        <div style="font-size:13px;color:var(--text-secondary);line-height:1.75;">
                            An economic strategy game by Students For Liberty. Build your city through seven eras — and live with the consequences of every decision.
                        </div>
                        <div class="beta-row" style="margin-top:12px;">
                            <span class="beta-label">Version</span>
                            <span class="beta-value">1.0 (beta)</span>
                        </div>
                    </div>-->

                    <div class="city-card">
                        <div class="settings-section-title">Settings</div>
                        <!--
                        <button class="settings-btn" @onclick="TestBadgeToast">Test badge toast</button>-->
                        <button class="settings-btn" style="margin-top:8px;" @onclick="RefreshGameData">Check for updates</button>
                        <!--
                        <button class="settings-btn" style="margin-top:8px;" @onclick="() => _nextIssueUtc = DateTime.UtcNow">Skip issue timer</button>
                        <button class="settings-btn" style="margin-top:8px;" @onclick="() => SaveService.Save(State, _eraStartUtc, _eraStartPop)">Save now</button>
                        <button class="settings-btn" style="margin-top:8px;" @onclick="ReplayTutorial">Replay tutorial</button>
                        <button class="settings-btn" style="margin-top:8px;" @onclick="CompleteEraIssues">Complete current era issues</button>-->
                        <button class="settings-btn danger" style="margin-top:8px;" @onclick="ResetGame">Reset game — Delete city</button>
                        <!--
                        <div style="margin-top:10px;font-family:var(--font-mono);font-size:11px;color:var(--text-muted);line-height:1.7;">
                            gate @GatedEraIdx · pop-era @Config.GetEraIndex(State.Population) · issues @EraIssuesDone/@EraIssuesTotal · anim @(State.EraUnlockAnimIndex?.ToString() ?? "—") · next-cer @(_lastCeremonyEra + 1)
                        </div>-->
                    </div>

                    <div class="city-card">
                        <div class="settings-section-title">For beta-testers</div>
                        <!--
                        <div class="beta-row">
                            <span class="beta-label">User ID</span>
                            <span class="beta-value beta-guid">@UserId</span>
                        </div>
                        <button class="settings-btn" style="margin:6px 0 10px;" @onclick="CopyUserId">@(_userIdCopied ? "Copied" : "Copy User ID")</button>-->
                        <div class="beta-row">
                            <span class="beta-label">Time played (online)</span>
                            <span class="beta-value">@TimePlayedOnline</span>
                        </div>
                        <div class="beta-row">
                            <span class="beta-label">Time since install</span>
                            <span class="beta-value">@TimeSinceInstall</span>
                        </div>
                        <div class="beta-row">
                            <span class="beta-label">Era reached</span>
                            <span class="beta-value">@CurrentEra.Name</span>
                        </div><!--
                        <div class="beta-row">
                            <span class="beta-label">Issue reached</span>
                            <span class="beta-value">@LastIssueReached()</span>
                        </div>
                        <div class="beta-row">
                            <span class="beta-label">Badges total</span>
                            <span class="beta-value">@BadgesTotal</span>
                        </div>
                        <div class="beta-row">
                            <span class="beta-label">Save file</span>
                            <span class="beta-value">@SaveService.Describe()</span>
                        </div>
                        <div class="beta-row">
                            <span class="beta-label">Save status</span>
                            <span class="beta-value" style="color:@(string.IsNullOrEmpty(SaveService.LastError) ? "var(--green)" : "var(--red)");">
                                @(string.IsNullOrEmpty(SaveService.LastError) ? "ok" : SaveService.LastError)
                            </span>
                        </div>-->
                        <div class="beta-row">
                            <span class="beta-label">Last restore</span>
                            <span class="beta-value">@(_restoreNote == "" ? "—" : _restoreNote)</span>
                        </div>
                    </div>

                </div>
            }

            @if (_refreshing)
            {
                <div class="load-screen load-overlay">
                    <div class="load-core">
                        <div class="load-mark">Age of Liberty</div>
                        <div class="load-bar"><div class="load-bar-fill"></div></div>
                        <div class="boot-status">Downloading simulation data</div>
                    </div>
                </div>
            }

            <!-- ═══ ISSUE CHIP: the appointment ═══ -->
            @if (_activeTab == Tab.Map && !State.DrawerOpen && State.Phase == GamePhase.Play)
            {
                <div class="issue-chip @(_issueHeld ? "ringing" : "")" @onclick="IssueChipTap">
                    @if (_issueHeld)
                    {
                        <span class="issue-bang">!</span>
                    }
                    else if (EraIssuesRemain)
                    {
                        <div class="issue-chip-label">Next issue</div>
                        <div id="issueCountdown" class="issue-chip-time">@_issueCountdown</div>
                    }
                    else
                    {
                        
                        <div class="issue-chip-label">More citizens needed to advance</div>
                    }
                </div>
            }

            <!-- ═══ DISPATCHES ═══ -->
            @if (_dispatchesOpen)
            {
                var pendingDispatches = FilteredDispatches.Where(d => d.IsPending).OrderBy(d => d.TriggerTurn).ToList();
                var resolvedDispatches = FilteredDispatches.Where(d => !d.IsPending).OrderByDescending(d => d.EventTurn).ToList();
                <div class="dispatch-panel" role="dialog" aria-modal="true" aria-label="Dispatches notification center">
                    <div class="dispatch-head">
                        <div class="dispatch-title-row">
                            <div>
                                <div class="dispatch-kicker">The Engine's Record</div>
                                <div class="dispatch-title">Dispatches</div>
                            </div>
                            <button class="dispatch-close" @onclick="CloseDispatches" aria-label="Close Dispatches">✕</button>
                        </div>
                        <div class="dispatch-actions">
                            <span class="dispatch-unread-count">@UnreadDispatchCount unread</span>
                            @if (UnreadDispatchCount > 0)
                            {
                                <button class="dispatch-mark-read" @onclick="MarkAllDispatchesRead">Mark all read</button>
                            }
                        </div>
                        <div class="dispatch-filters" aria-label="Dispatch filters">
                            <button class="dispatch-filter @(_dispatchFilter == DispatchFilter.All ? "on" : "")" @onclick="() => SetDispatchFilter(DispatchFilter.All)">All</button>
                            <button class="dispatch-filter @(_dispatchFilter == DispatchFilter.Consequences ? "on" : "")" @onclick="() => SetDispatchFilter(DispatchFilter.Consequences)">Consequences</button>
                            @if (State.Dispatches.Any(d => d.Kind == DispatchKind.Progress))
                            {
                                <button class="dispatch-filter @(_dispatchFilter == DispatchFilter.Progress ? "on" : "")" @onclick="() => SetDispatchFilter(DispatchFilter.Progress)">Progress</button>
                            }
                            @if (State.Dispatches.Any(d => d.Kind == DispatchKind.Warning))
                            {
                                <button class="dispatch-filter @(_dispatchFilter == DispatchFilter.Warnings ? "on" : "")" @onclick="() => SetDispatchFilter(DispatchFilter.Warnings)">Warnings</button>
                            }
                        </div>
                    </div>

                    @if (pendingDispatches.Count > 0)
                    {
                        <div class="dispatch-unfolding">
                            <div class="dispatch-unfolding-head"><span>Unfolding</span><span>@pendingDispatches.Count pending</span></div>
                            @foreach (var dispatch in pendingDispatches)
                            {
                                <button class="dispatch-pending-row" @onclick="() => OpenDispatchDetail(dispatch.Id)">
                                    <span class="dispatch-pending-icon">⌛</span>
                                    <span class="dispatch-pending-copy">
                                        <span class="dispatch-pending-title">@dispatch.Cause</span>
                                        <span class="dispatch-pending-sub">Decided T@dispatch.DecisionTurn · outcome not yet known</span>
                                    </span>
                                    <span class="dispatch-pending-eta">@Math.Max(0, (dispatch.TriggerTurn ?? State.Turn) - State.Turn) turns</span>
                                </button>
                            }
                        </div>
                    }

                    <div class="dispatch-list">
                        @if (pendingDispatches.Count == 0 && resolvedDispatches.Count == 0)
                        {
                            <div class="dispatch-empty">
                                <div class="dispatch-empty-hex">⬡</div>
                                <div class="dispatch-empty-title">Nothing to report</div>
                                <div class="dispatch-empty-copy">Decisions and their consequences are recorded here as they happen. Your first issue is on its way.</div>
                            </div>
                        }
                        @foreach (var group in resolvedDispatches.GroupBy(d => d.EventTurn))
                        {
                            <div class="dispatch-turn-marker">Turn @group.Key</div>
                            @foreach (var dispatch in group)
                            {
                                <button class="dispatch-item @(!dispatch.IsRead ? "unread" : "")" @onclick="() => OpenDispatchDetail(dispatch.Id)">
                                    @if (!dispatch.IsRead)
                                    {
                                        <span class="dispatch-unread-dot"></span>
                                    }
                                    <span class="dispatch-item-icon">@DispatchIcon(dispatch)</span>
                                    <span class="dispatch-item-body">
                                        <span class="dispatch-item-meta">
                                            <span>@DispatchLabel(dispatch)</span>
                                            <span>@(dispatch.EventTurn == dispatch.DecisionTurn ? $"T{dispatch.EventTurn}" : $"decided T{dispatch.DecisionTurn}")</span>
                                        </span>
                                        <span class="dispatch-item-cause">@dispatch.Cause</span>
                                        <span class="dispatch-item-text">@dispatch.DisplayOutcome</span>
                                        @if (dispatch.DisplayPriceChanges.Count > 0)
                                        {
                                            <span class="dispatch-deltas">
                                                @foreach (var change in dispatch.DisplayPriceChanges.Take(3))
                                                {
                                                    var atom = Config.AtomsById.GetValueOrDefault(change.AtomId);
                                                    <span class="dispatch-delta @(change.PercentChange > 0 ? "up" : "down")">@(atom?.Icon ?? "◆") @(atom?.Name ?? "Price") @(change.PercentChange > 0 ? "▲" : "▼")@Math.Abs(change.PercentChange).ToString("0.#")%</span>
                                                }
                                            </span>
                                        }
                                    </span>
                                </button>
                            }
                        }
                    </div>
                </div>
            }

            @if (State.Phase == GamePhase.GameOver)
            {
                <div class="ouster-overlay" role="dialog" aria-modal="true" aria-label="Mayor ousted">
                    <div class="ouster-card">
                        <div class="ouster-kicker">Mandate lost</div>
                        <div class="ouster-seal">⚖</div>
                        <h1>The mayor has been ousted</h1>
                        <p>@State.GameOverReason</p>
                        <div class="ouster-metrics">
                            <span><small>Affordability</small><b>@Pressure.AffordabilityLabel</b></span>
                            <span><small>Growth · 10T</small><b>@GrowthDisplay</b></span>
