    private bool _buildMenuOpen;

    private async Task BuildMany(int atomId, int count)
    {
        _buildMenuOpen = false;
        if (!Config.AtomsById.TryGetValue(atomId, out var atom)) { StateHasChanged(); return; }
        var (built, spent) = Economy.TryBuildBulk(atomId, count);
        if (built > 0)
        {
            try
            {
                await JS.InvokeVoidAsync("AgeOfLibertyAudio.sfxBuild");
                await JS.InvokeVoidAsync("AgeOfLibertyJuice.buildCelebrationAt",
                    "atomSvg", atom.PositionX, RY(atom), atom.PopGain * built, spent);
                await JS.InvokeVoidAsync("AgeOfLibertyJuice.floatTextAt",
                    "atomSvg", atom.PositionX, RY(atom) - 46, $"×{built} built", "#f0c860");
                await JS.InvokeVoidAsync("AgeOfLibertyJuice.hudBump", "hudGold");
            }
            catch { }
            await CheckAndShowBadge(atomId);
        }
        StateHasChanged();
    }

    private async Task BuildAtom(int atomId)
    {
        if (Config.AtomsById.TryGetValue(atomId, out var atom))
        {
            var cost = State.GetBuildCost(atom, Config);
            if (Economy.TryBuild(atomId))
            {
                try
                {
                    await JS.InvokeVoidAsync("AgeOfLibertyAudio.sfxBuild");
                    await JS.InvokeVoidAsync("AgeOfLibertyJuice.buildCelebrationAt",
                        "atomSvg", atom.PositionX, RY(atom), atom.PopGain, cost);
                    await JS.InvokeVoidAsync("AgeOfLibertyJuice.hudBump", "hudGold");
                }
                catch { }
                // Check for new badge
                await CheckAndShowBadge(atomId);
            }
        }
        StateHasChanged();
    }

