@page "/"
@using AgeOfLiberty.Models
@using AgeOfLiberty.Services
@inject GameState State
@inject GameConfigStore Config
@inject EconomyEngine Economy
@inject ScenarioEngine Scenarios
@inject DirectusClient Directus
@inject IJSRuntime JS
@implements IDisposable

@if (!_loaded)
{
    <div class="loading">
        <div class="loading-icon">🏛️</div>
        <div class="loading-text">Updating...</div>
    </div>
}
else if (State.Phase == GamePhase.Intro)
{
    <div class="intro-screen">
        <canvas id="bgParticles" class="bg-particles"></canvas>
        <div class="intro-content">
            <div class="intro-glyph">
                <span class="intro-glyph-icon">🏛️</span>
                <div class="intro-ring"></div>
                <div class="intro-ring intro-ring-2"></div>
            </div>
            <h1 class="intro-title">LIBERTY CITY</h1>
            <p class="intro-tag">Build a civilization. Face dilemmas.<br />Watch consequences cascade.</p>
            <div class="intro-lore">
                <p>You are the founder of a small settlement on the edge of the wilderness.</p>
                <p>Every resource is connected. Every decision ripples through the economy.</p>
                <p>The only question is: <em class="accent">how free will your city be?</em></p>
            </div>
            <div class="name-input-wrap">
                <label class="name-label">Name your city</label>
                <input class="name-input" type="text" maxlength="24"
                       @bind="State.CityName" @bind:event="oninput"
                       placeholder="Liberty City" />
            </div>
            <button class="start-btn" @onclick="StartGame">
                <span>FOUND YOUR VILLAGE</span>
                <span class="start-arrow">→</span>
            </button>
        </div>
    </div>
}
else
{
    <div class="game-container">
        <canvas id="bgParticles" class="bg-particles"></canvas>

        <div class="hud">
            <div class="hud-left">
                <div class="hud-stat">
                    <span class="hud-emoji">💰</span>
                    <div class="hud-stat-inner">
                        <div class="hud-num gold-color">$@EconomyEngine.FormatNumber(State.Gold)</div>
                        <div class="hud-rate">+@EconomyEngine.FormatNumber(Economy.GetIncomeRate())/min</div>
                    </div>
                </div>
                <div class="hud-divider"></div>
                <div class="hud-stat">
                    <span class="hud-emoji">👥</span>
                    <div class="hud-stat-inner">
                        <div class="hud-num pop-color">@EconomyEngine.FormatNumber(State.Population)</div>
                    </div>
                </div>
            </div>
            <div class="hud-center">
                <div class="hud-era-name" style="color: @CurrentEra.Color">@CurrentEra.Name</div>
                <div class="hud-era-sub">Turn @State.Turn</div>
            </div>
            <div class="hud-right">
                <button class="hud-icon-btn" @onclick="ToggleSummary">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6b8aaa" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="16.5" y1="16.5" x2="21" y2="21" /></svg>
                </button>
                <button class="hud-icon-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6b8aaa" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                </button>
            </div>
        </div>

        <div class="zoom-controls">
            <button class="zoom-btn" @onclick="ZoomIn">+</button>
            <div class="zoom-level">@((int)(_zoom * 100))%</div>
            <button class="zoom-btn" @onclick="ZoomOut">−</button>
            <button class="zoom-btn zoom-reset" @onclick="ZoomReset">⟲</button>
        </div>

        @if (State.FeedbackText != null)
        {
            <div class="toast">@State.FeedbackText</div>
        }

        @if (State.EraUnlockAnimIndex is int eraIdx)
        {
            var eraData = Config.Eras[eraIdx];
            <div class="overlay era-unlock-overlay" @onclick="DismissEraUnlock">
                <div id="eraUnlockCanvas" class="era-3d-canvas"></div>
                <div class="era-unlock-ui">
                    <div class="era-unlock-label">New Era Unlocked</div>
                    <div class="era-unlock-name" style="color: @eraData.Color">@eraData.Name</div>
                    <div class="era-unlock-sub">New atoms available</div>
                    <div class="era-unlock-tap">Tap to continue</div>
                </div>
            </div>
        }

        @if (State.Phase == GamePhase.Scenario && State.ActiveScenario is Scenario s)
        {
            var character = Config.CharsById.GetValueOrDefault(s.CharacterId);
            var choices = Config.GetChoices(s.Id);
            <div class="overlay">
                <div class="scenario-card">
                    <div class="scenario-head">
                        <span class="scenario-char-icon">@(character?.Icon ?? "❓")</span>
                        <div>
                            <div class="scenario-char-name">@(character?.Name ?? "Unknown")</div>
                            <div class="scenario-char-role">@(character?.Role ?? "")</div>
                        </div>
                    </div>
                    <p class="scenario-text">@s.Text</p>
                    <div class="scenario-choices">
                        @foreach (var choice in choices)
                        {
                            var cid = choice.Id;
                            <button class="choice-btn" @onclick="() => HandleChoice(cid)">
                                @choice.Label
                            </button>
                        }
                    </div>
                </div>
            </div>
        }

        @if (State.ShowSummary)
        {
            var freedom = State.ComputeFreedomScore();
            var totalBuildings = State.Built.Values.Sum();
            <div class="overlay" @onclick="ToggleSummary">
                <div class="scenario-card" style="max-height:80vh;overflow-y:auto;" @onclick:stopPropagation="true">
                    <div style="text-align:center;margin-bottom:20px;">
                        <div style="font-size:40px;">🏛️</div>
                        <div style="font-size:22px;font-weight:800;color:#4aeadc;letter-spacing:3px;margin-top:8px;">@State.CityName</div>
                        <div style="font-size:12px;color:#6b8aaa;margin-top:4px;">@CurrentEra.Name · Turn @State.Turn</div>
                    </div>
                    <div style="display:flex;align-items:center;gap:16px;padding:16px;background:rgba(10,30,54,0.5);border:1px solid #0d2a42;border-radius:12px;margin-bottom:16px;">
                        <div style="font-size:36px;font-weight:800;color:@(freedom.Score >= 70 ? "#4aeadc" : freedom.Score >= 40 ? "#ffd166" : "#ff6b6b");font-family:'JetBrains Mono',monospace;">@freedom.Score</div>
                        <div>
                            <div style="font-size:16px;font-weight:700;color:#c8dce8;">@freedom.Title</div>
                            <div style="font-size:12px;color:#6b8aaa;">Liberty Index · Grade @freedom.Grade</div>
                        </div>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;margin-bottom:16px;">
                        <div style="text-align:center;background:rgba(10,30,54,0.5);border:1px solid #0d2a42;border-radius:10px;padding:10px 4px;">
                            <div style="font-size:16px;font-weight:700;color:#c8dce8;font-family:'JetBrains Mono',monospace;">@EconomyEngine.FormatNumber(State.Population)</div>
                            <div style="font-size:9px;color:#3a5a7a;text-transform:uppercase;letter-spacing:1px;margin-top:2px;">Citizens</div>
                        </div>
                        <div style="text-align:center;background:rgba(10,30,54,0.5);border:1px solid #0d2a42;border-radius:10px;padding:10px 4px;">
                            <div style="font-size:16px;font-weight:700;color:#c8dce8;font-family:'JetBrains Mono',monospace;">@EconomyEngine.FormatNumber(State.Gold)</div>
                            <div style="font-size:9px;color:#3a5a7a;text-transform:uppercase;letter-spacing:1px;margin-top:2px;">SFL$</div>
                        </div>
                        <div style="text-align:center;background:rgba(10,30,54,0.5);border:1px solid #0d2a42;border-radius:10px;padding:10px 4px;">
                            <div style="font-size:16px;font-weight:700;color:#c8dce8;font-family:'JetBrains Mono',monospace;">@totalBuildings</div>
                            <div style="font-size:9px;color:#3a5a7a;text-transform:uppercase;letter-spacing:1px;margin-top:2px;">Buildings</div>
                        </div>
                        <div style="text-align:center;background:rgba(10,30,54,0.5);border:1px solid #0d2a42;border-radius:10px;padding:10px 4px;">
                            <div style="font-size:16px;font-weight:700;color:#c8dce8;font-family:'JetBrains Mono',monospace;">@State.ChoiceEvents.Count</div>
                            <div style="font-size:9px;color:#3a5a7a;text-transform:uppercase;letter-spacing:1px;margin-top:2px;">Decisions</div>
                        </div>
                    </div>
                    @if (State.ChoiceEvents.Count > 0)
                    {
                        <div style="font-size:10px;color:#6b8aaa;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;">Your decisions</div>
                        @foreach (var ev in State.ChoiceEvents)
                        {
                            <div style="display:flex;align-items:center;gap:10px;padding:8px 12px;background:rgba(10,30,54,0.4);border:1px solid #0d2a42;border-radius:10px;margin-bottom:6px;">
                                <div style="width:8px;height:8px;border-radius:50%;background:#ffd166;flex-shrink:0;"></div>
                                <div style="font-size:10px;color:#3a5a7a;font-family:'JetBrains Mono',monospace;min-width:28px;">T@ev.Turn</div>
                                <div style="font-size:12px;color:#8aaccc;">@ev.Label</div>
                            </div>
                        }
                    }
                    <div style="text-align:center;margin-top:16px;">
                        <button class="build-btn" @onclick="ShareCity">SHARE YOUR CITY</button>
                        <div style="font-size:12px;color:#6b8aaa;margin-top:10px;">Can your friends build a freer city?</div>
                        <div style="font-size:10px;color:#3a5a7a;margin-top:12px;padding-top:10px;border-top:1px solid #0d2a42;">A game by <span style="color:#6b8aaa;font-weight:600;">Students For Liberty</span></div>
                    </div>
                </div>
            </div>
        }

        @if (_stockViewAtomId is int svId && Config.AtomsById.TryGetValue(svId, out var svAtom))
        {
            var svHistory = State.PriceHistory;
            if (svHistory.Count >= 2)
            {
                var svPrices = svHistory.Select(h => h.Prices.GetValueOrDefault(svId, svAtom.BasePrice)).ToList();
                var compPrices = _compareAtomId.HasValue
                    ? svHistory.Select(h => h.Prices.GetValueOrDefault(_compareAtomId.Value, 0)).ToList()
                    : new List<int>();
                var allVals = svPrices.Concat(compPrices).Where(v => v > 0).ToList();
                var svMin = allVals.Min(); var svMax = allVals.Max(); var svRange = Math.Max(svMax - svMin, 1);
                var svFirst = svPrices[0]; var svLast = svPrices[^1];
                var svTrend = svLast > svFirst ? "#4ade80" : svLast < svFirst ? "#ff6b6b" : "#6b8aaa";
                var svPct = svFirst > 0 ? (int)Math.Round(((double)(svLast - svFirst) / svFirst) * 100) : 0;

                var W = 560; var H = 220; var padX = 44; var padY = 24;
                var chartW = W - padX * 2; var chartH = H - padY * 2;

                string toX(int i) => ((double)padX + (double)i / (svHistory.Count - 1) * chartW).ToString("F1");
                string toY(int v) => ((double)padY + (1.0 - (double)(v - svMin) / svRange) * chartH).ToString("F1");

                var mainLine = string.Join(" ", svPrices.Select((p, i) => $"{toX(i)},{toY(p)}"));
                var mainFill = $"{padX},{padY + chartH} {mainLine} {toX(svPrices.Count - 1)},{padY + chartH}";
                var compLine = compPrices.Count > 0
                    ? string.Join(" ", compPrices.Select((p, i) => $"{toX(i)},{toY(p)}"))
                    : "";

                var yTicks = Enumerable.Range(0, 5).Select(i =>
                {
                    var v = svMin + svRange * i / 4;
                    return new { Val = v, Y = double.Parse(toY(v), System.Globalization.CultureInfo.InvariantCulture) };
                }).ToList();

                var svEvents = State.ChoiceEvents
                    .Where(e => e.AffectedAtomIds.Contains(svId) || (_compareAtomId.HasValue && e.AffectedAtomIds.Contains(_compareAtomId.Value)))
                    .Select(e =>
                    {
                        var idx = svHistory.FindIndex(h => h.Turn >= e.Turn);
                        return idx >= 0 ? new { e.Label, X = double.Parse(toX(idx), System.Globalization.CultureInfo.InvariantCulture) } : null;
                    })
                    .Where(x => x != null).ToList();

                var compAtom = _compareAtomId.HasValue && Config.AtomsById.TryGetValue(_compareAtomId.Value, out var ca) ? ca : null;
                var comparables = Config.Atoms.Where(a => a.Id != svId).Take(12).ToList();

                <div class="overlay" @onclick="CloseStockView">
                    <div class="stock-card" @onclick:stopPropagation="true">

                        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
                            <span style="font-size:28px;">@svAtom.Icon</span>
                            <div>
                                <div style="font-size:20px;font-weight:700;color:#4aeadc;">@svAtom.Name</div>
                                <div style="font-family:'JetBrains Mono',monospace;">
                                    <span style="color:@svTrend;font-weight:600;">$@svLast</span>
                                    <span style="color:@svTrend;font-size:12px;"> (@(svPct >= 0 ? "+" : "")@(svPct)%)</span>
                                </div>
                            </div>
                            <button class="stock-close" @onclick="CloseStockView">✕</button>
                        </div>

                        <!-- Chart -->
                        <div class="stock-chart-wrap">
                            <svg viewBox="0 0 @W @H" style="width:100%;height:auto;display:block;">
                                <defs>
                                    <linearGradient id="sv-fill" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="@svTrend" stop-opacity="0.15" />
                                        <stop offset="100%" stop-color="@svTrend" stop-opacity="0" />
                                    </linearGradient>
                                </defs>
                                <!-- Grid -->
                                @foreach (var yt in yTicks)
                                {
                                    <line x1="@padX" y1="@yt.Y.ToString("F1")" x2="@(W - padX)" y2="@yt.Y.ToString("F1")" stroke="#0d2a42" stroke-width="0.5" />
                                    @((MarkupString)$"<text x=\"{padX - 6}\" y=\"{yt.Y + 3:F1}\" text-anchor=\"end\" font-size=\"9\" fill=\"#3a5a7a\" font-family=\"'JetBrains Mono', monospace\">${yt.Val}</text>")
                                }
                                <!-- Fill -->
                                <polygon points="@mainFill" fill="url(#sv-fill)" />
                                <!-- Main line -->
                                <polyline points="@mainLine" fill="none" stroke="@svTrend" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <!-- Compare line -->
                                @if (!string.IsNullOrEmpty(compLine))
                                {
                                    <polyline points="@compLine" fill="none" stroke="#818cf8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="4 3" />
                                }
                                <!-- Event markers -->
                                @foreach (var ev in svEvents)
                                {
                                    <line x1="@ev!.X.ToString("F1")" y1="@padY" x2="@ev.X.ToString("F1")" y2="@(padY + chartH)" stroke="#ffd166" stroke-width="1" stroke-dasharray="3 3" opacity="0.5" />
                                    <circle cx="@ev.X.ToString("F1")" cy="@(padY - 2)" r="5" fill="#ffd166" stroke="#04151e" stroke-width="1.5" />
                                    @((MarkupString)$"<text x=\"{ev.X:F1}\" y=\"{padY - 12}\" text-anchor=\"middle\" font-size=\"7\" fill=\"#ffd166\" font-family=\"'JetBrains Mono', monospace\">{(ev.Label.Length > 18 ? ev.Label[..16] + "…" : ev.Label)}</text>")
                                }
                            </svg>
                        </div>

                        <!-- Legend -->
                        <div class="stock-legend">
                            <div class="stock-legend-item">
                                <div style="width:12px;height:3px;background:@svTrend;border-radius:2px;"></div>
                                <span>@svAtom.Icon @svAtom.Name</span>
                            </div>
                            @if (compAtom != null)
                            {
                                <div class="stock-legend-item">
                                    <div style="width:12px;height:3px;background:#818cf8;border-radius:2px;"></div>
                                    <span>@compAtom.Icon @compAtom.Name</span>
                                    <button class="stock-remove-cmp" @onclick="() => _compareAtomId = null">✕</button>
                                </div>
                            }
                            <div class="stock-legend-item">
                                <div style="width:8px;height:8px;background:#ffd166;border-radius:50%;"></div>
                                <span>Policy decision</span>
                            </div>
                        </div>

                        <div class="stock-compare">
                            <div style="font-size:10px;color:#6b8aaa;letter-spacing:1px;font-family:'JetBrains Mono',monospace;text-transform:uppercase;margin-bottom:8px;">COMPARE WITH</div>
                            <div class="stock-compare-grid">
                                @foreach (var ca2 in comparables)
                                {
                                    var cId = ca2.Id;
                                    <button class="stock-compare-chip @(_compareAtomId == cId ? "active" : "")"
                                            @onclick="() => _compareAtomId = _compareAtomId == cId ? null : cId">
                                        <span style="font-size:14px;">@ca2.Icon</span>
                                        <span style="font-size:10px;">@ca2.Name</span>
                                    </button>
                                }
                            </div>
                        </div>

                        @if (svEvents.Count > 0)
                        {
                            <div style="padding-top:12px;border-top:1px solid #0d2a42;">
                                <div style="font-size:10px;color:#6b8aaa;letter-spacing:1px;font-family:'JetBrains Mono',monospace;text-transform:uppercase;margin-bottom:8px;">POLICY DECISIONS</div>
                                @foreach (var ev in State.ChoiceEvents.Where(e => e.AffectedAtomIds.Contains(svId)))
                                {
                                    <div style="display:flex;align-items:center;gap:10px;padding:6px 0;">
                                        <div style="width:8px;height:8px;border-radius:50%;background:#ffd166;flex-shrink:0;"></div>
                                        <div>
                                            <div style="font-size:12px;color:#c8dce8;">@ev.Label</div>
                                            <div style="font-size:10px;color:#3a5a7a;">Turn @ev.Turn</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="overlay" @onclick="CloseStockView">
                    <div class="stock-card" @onclick:stopPropagation="true">
                        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
                            <span style="font-size:28px;">@svAtom.Icon</span>
                            <div style="font-size:20px;font-weight:700;color:#4aeadc;">@svAtom.Name</div>
                            <button class="stock-close" @onclick="CloseStockView">✕</button>
                        </div>
                        <div style="padding:40px;text-align:center;color:#3a5a7a;">Not enough data yet. Play a few more turns.</div>
                    </div>
                </div>
            }
        }

        <!-- Graph atomes -->
        <div class="graph-area" id="graphArea">
            <svg viewBox="0 0 660 850" class="atom-svg" id="atomSvg"
                 style="transform: translate(@(_panX)px, @(_panY)px) scale(@_zoom); transform-origin: center top; cursor: grab;">

                <defs>
                    <filter id="glow"><feGaussianBlur stdDeviation="4" result="g" /><feMerge><feMergeNode in="g" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
                    <filter id="softglow"><feGaussianBlur stdDeviation="6" result="g" /><feMerge><feMergeNode in="g" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
                </defs>

                @foreach (var atom in AvailableAtoms)
                {
                    var deps = Config.GetDependencies(atom.Id);
                    foreach (var dep in deps)
                    {
                        if (!Config.AtomsById.TryGetValue(dep.RequiresAtomId, out var reqAtom)) continue;
                        if (!AvailableAtoms.Contains(reqAtom)) continue;
                        var isCasc = State.Cascading.GetValueOrDefault(atom.Id) || State.Cascading.GetValueOrDefault(reqAtom.Id);
                        var isSel = State.SelectedAtomId == atom.Id;
                        var isBuilt = State.GetBuiltCount(atom.Id) > 0;
                        <line x1="@reqAtom.PositionX" y1="@reqAtom.PositionY"
                              x2="@atom.PositionX" y2="@atom.PositionY"
                              stroke="@(isCasc ? "#ff6b6b" : isSel ? "#4aeadc" : isBuilt ? "#1e3a5f" : "#0d1f35")"
                              stroke-width="@(isCasc ? "3" : isSel ? "2.5" : isBuilt ? "1.5" : "0.7")"
                              filter="@(isCasc ? "url(#glow)" : "none")"
                              opacity="@(isBuilt ? "0.9" : "0.35")" />
                    }
                }

                @foreach (var atom in AvailableAtoms)
                {
                    var isCasc = State.Cascading.GetValueOrDefault(atom.Id);
                    var isSel = State.SelectedAtomId == atom.Id;
                    var count = State.GetBuiltCount(atom.Id);
                    var price = State.GetPrice(atom);
                    var eraColor = Config.ErasById.GetValueOrDefault(atom.EraId)?.Color ?? "#1a3050";
                    var r = isSel ? 54 : 48;

                    <g data-node @onclick="() => SelectAtom(atom.Id)" style="cursor: pointer;">
                        @if (count > 0)
                        {
                            <circle cx="@atom.PositionX" cy="@atom.PositionY" r="64"
                                    fill="none" stroke="@eraColor" stroke-width="1" opacity="0.2" class="breathe" />
                        }
                        <circle cx="@atom.PositionX" cy="@atom.PositionY" r="@r"
                                fill="@(isCasc ? "#ff6b6b10" : isSel ? "#4aeadc10" : count > 0 ? "#0a1e36" : "#060e1a")"
                                stroke="@(isCasc ? "#ff6b6b" : isSel ? "#4aeadc" : count > 0 ? eraColor : "#1a3050")"
                                stroke-width="@(isCasc ? "3" : isSel ? "3" : count > 0 ? "2" : "1")"
                                filter="@(isCasc ? "url(#glow)" : isSel ? "url(#softglow)" : "none")" />
                        @((MarkupString)$"<text x=\"{atom.PositionX}\" y=\"{atom.PositionY}\" text-anchor=\"middle\" font-size=\"34\" dominant-baseline=\"central\">{atom.Icon}</text>")
                        @((MarkupString)$"<text x=\"{atom.PositionX}\" y=\"{atom.PositionY + 62}\" text-anchor=\"middle\" font-size=\"14\" fill=\"{(isCasc ? "#ff6b6b" : "#6b8aaa")}\" font-family=\"'JetBrains Mono', monospace\" font-weight=\"500\">{atom.Name}</text>")
                        @((MarkupString)$"<text x=\"{atom.PositionX}\" y=\"{atom.PositionY + 78}\" text-anchor=\"middle\" font-size=\"12\" fill=\"{(isCasc ? "#ff6b6b" : "#3a5a7a")}\" font-family=\"'JetBrains Mono', monospace\">${EconomyEngine.FormatNumber(price)}</text>")
                        @if (count > 0)
                        {
                            <rect x="@(atom.PositionX + 30)" y="@(atom.PositionY - 42)" width="28" height="18" rx="9" fill="#4aeadc" opacity="0.9" />
                            @((MarkupString)$"<text x=\"{atom.PositionX + 44}\" y=\"{atom.PositionY - 33}\" text-anchor=\"middle\" dominant-baseline=\"central\" font-size=\"11\" fill=\"#04151e\" font-family=\"'JetBrains Mono', monospace\" font-weight=\"700\">×{count}</text>")
                        }
                        @if (atom.PopGain > 0 && count > 0)
                        {
                            <rect x="@(atom.PositionX - 58)" y="@(atom.PositionY - 42)" width="36" height="18" rx="9" fill="#818cf8" opacity="0.8" />
                            @((MarkupString)$"<text x=\"{atom.PositionX - 40}\" y=\"{atom.PositionY - 33}\" text-anchor=\"middle\" dominant-baseline=\"central\" font-size=\"11\" fill=\"#e0e0ff\" font-family=\"'JetBrains Mono', monospace\" font-weight=\"600\">+{atom.PopGain}</text>")
                        }
                    </g>
                }
            </svg>
        </div>

        <!-- BOTTOM DRAWER -->
        @if (State.DrawerOpen && SelectedAtom is Atom sel)
        {
            var deps = Config.GetDependencies(sel.Id);
            var cost = State.GetBuildCost(sel, Config);
            var canBuild = State.Gold >= cost && (deps.Count > 0 || sel.PopGain > 0);

            <div class="drawer open">
                <div class="drawer-handle" @onclick="CloseDrawer"><div class="drawer-pill"></div></div>
                <div class="drawer-content">
                    <div class="drawer-header">
                        <span class="drawer-icon">@sel.Icon</span>
                        <div>
                            <div class="drawer-title">@sel.Name</div>
                            <div class="drawer-meta">
                                @if (sel.PopGain > 0)
                                {
                                    <span class="pop-tag">+@sel.PopGain pop</span>
                                }
                                @if (State.GetBuiltCount(sel.Id) > 0)
                                {
                                    <span class="built-tag">Built ×@State.GetBuiltCount(sel.Id)</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (deps.Count > 0)
                    {
                        <div class="deps-grid">
                            @foreach (var dep in deps)
                            {
                                if (!Config.AtomsById.TryGetValue(dep.RequiresAtomId, out var reqAtom)) continue;
                                var depPrice = State.GetPrice(reqAtom);
                                <div class="dep-chip">
                                    <span class="dep-emoji">@reqAtom.Icon</span>
                                    <div>
                                        <div class="dep-name">@reqAtom.Name ×@dep.Quantity</div>
                                        <div class="dep-cost">$@EconomyEngine.FormatNumber(depPrice * dep.Quantity)</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="dep-chip" style="justify-content:center">
                            <span class="dep-cost">Base resource · $@EconomyEngine.FormatNumber(State.GetPrice(sel))</span>
                        </div>
                    }

                    <!-- Sparkline -->
                    @{
                        var history = State.PriceHistory;
                    }
                    <div class="sparkline-wrap" @onclick="() => OpenStockView(sel.Id)">
                        @if (history.Count >= 2)
                        {
                            var prices = history.Select(h => h.Prices.GetValueOrDefault(sel.Id, sel.BasePrice)).ToList();
                            var sMin = prices.Min(); var sMax = prices.Max(); var sRange = Math.Max(sMax - sMin, 1);
                            var first = prices[0]; var last = prices[^1];
                            var trend = last > first ? "#4ade80" : last < first ? "#ff6b6b" : "#6b8aaa";
                            var pct = first > 0 ? (int)Math.Round(((double)(last - first) / first) * 100) : 0;
                            var sW = 200; var sH = 40; var sPad = 4;
                            var points = string.Join(" ", prices.Select((p, i) =>
                            {
                                var sx = (double)i / (prices.Count - 1) * sW;
                                var sy = sPad + (1.0 - (double)(p - sMin) / sRange) * (sH - sPad * 2);
                                return $"{sx:F1},{sy:F1}";
                            }));
                            var fillPoints = $"0,{sH} {points} {sW},{sH}";
                            var evMarkers = State.ChoiceEvents
                                .Where(e => e.AffectedAtomIds.Contains(sel.Id))
                                .Select(e => { var idx = history.FindIndex(h => h.Turn >= e.Turn); return idx >= 0 ? (double)idx / (history.Count - 1) * sW : -1; })
                                .Where(x => x >= 0).ToList();

                            <div class="sparkline-header">
                                <span class="sparkline-label">PRICE HISTORY</span>
                                <span style="font-size:11px;color:@trend;font-weight:600;font-family:'JetBrains Mono',monospace;">@(pct >= 0 ? "+" : "")@(pct)%</span>
                            </div>
                            <svg viewBox="0 0 @sW @sH" style="width:100%;height:40px;display:block;">
                                <defs>
                                    <linearGradient id="spark-fill" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="@trend" stop-opacity="0.2" />
                                        <stop offset="100%" stop-color="@trend" stop-opacity="0" />
                                    </linearGradient>
                                </defs>
                                <polygon points="@fillPoints" fill="url(#spark-fill)" />
                                <polyline points="@points" fill="none" stroke="@trend" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                @foreach (var mx in evMarkers)
                                {
                                    <circle cx="@mx.ToString("F1")" cy="4" r="3" fill="#ffd166" stroke="#04151e" stroke-width="1" />
                                }
                            </svg>
                            <div class="sparkline-hint">Tap for full chart →</div>
                        }
                        else
                        {
                            <div style="text-align:center;padding:12px 0;font-size:10px;color:#3a5a7a;">No price data yet</div>
                        }
                    </div>

                    <div class="drawer-footer">
                        <div class="total-label">Total: <span class="@(canBuild ? "accent" : "danger")">$@EconomyEngine.FormatNumber(cost)</span></div>
                        @if (deps.Count > 0 || sel.PopGain > 0)
                        {
                            <button class="build-btn" disabled="@(!canBuild)" @onclick="() => Economy.TryBuild(sel.Id)">
                                @(canBuild ? $"BUILD · ${EconomyEngine.FormatNumber(cost)}" : $"NEED ${EconomyEngine.FormatNumber(cost)}")
                            </button>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Chronicle -->
        <div class="chronicle @(_chronicleOpen ? "open" : "")" @onclick="ToggleChronicle">
            <div class="chronicle-header">
                <span class="chronicle-label">📜 CHRONICLE</span>
                <span class="chronicle-toggle">@(_chronicleOpen ? "▾" : "▸")</span>
            </div>
            @if (_chronicleOpen)
            {
                <div class="chronicle-list">
                    @foreach (var (entry, i) in State.Log.Take(10).Select((e, i) => (e, i)))
                    {
                        <div class="chronicle-item" style="opacity: @(1 - i * 0.08)">@entry</div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private bool _loaded;
    private double _zoom = 1;
    private double _panX, _panY;
    private bool _chronicleOpen;
    private int? _stockViewAtomId;
    private int? _compareAtomId;

    private bool _particlesInitialized;
    private bool _gesturesInitialized;
    private bool _edgeParticlesInitialized;
    private DotNetObjectReference<GamePage>? _dotnetRef;
    private int _lastBuiltHash;
    private int? _lastEraUnlockIdx;

    private Era CurrentEra => Config.GetEra(State.Population);
    private List<Atom> AvailableAtoms => Config.GetAvailableAtoms(Config.GetEraIndex(State.Population));
    private Atom? SelectedAtom => State.SelectedAtomId.HasValue && Config.AtomsById.TryGetValue(State.SelectedAtomId.Value, out var a) ? a : null;

    protected override async Task OnInitializedAsync()
    {
        Scenarios.Economy = Economy;

        var bundle = await Directus.LoadBundleFromCacheAsync();
        if (bundle == null)
        {
            bundle = await Directus.FetchGameBundleAsync();
            if (bundle != null)
                await Directus.SaveBundleToCacheAsync(bundle);
        }

        if (bundle != null)
        {
            Config.Load(bundle);
            _loaded = true;
        }

        State.OnStateChanged += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loaded) return;

        // Background particles
        if (!_particlesInitialized)
        {
            await Task.Delay(150);
            try
            {
                await JS.InvokeVoidAsync("AgeOfLiberty.initParticles", "bgParticles");
                _particlesInitialized = true;
            }
            catch { }
        }

        // Touch gestures
        if (State.Phase == GamePhase.Play && !_gesturesInitialized)
        {
            await Task.Delay(100);
            try
            {
                _dotnetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("AgeOfLiberty.initTouchGestures", "graphArea", _dotnetRef);
                _gesturesInitialized = true;
            }
            catch { }
        }

        // Edge particles
        if (State.Phase == GamePhase.Play && !_edgeParticlesInitialized)
        {
            await Task.Delay(100);
            try
            {
                await JS.InvokeVoidAsync("AgeOfLiberty.initEdgeParticles", "atomSvg");
                _edgeParticlesInitialized = true;
                await UpdateEdgeParticles();
            }
            catch { }
        }

        // Update edge particles when buildings change
        if (_edgeParticlesInitialized)
        {
            var hash = State.Built.Sum(kv => kv.Key * 1000 + kv.Value);
            if (hash != _lastBuiltHash)
            {
                _lastBuiltHash = hash;
                await UpdateEdgeParticles();
            }
        }

        // Era unlock 3D animation
        if (State.EraUnlockAnimIndex is int eraUnlockIdx && eraUnlockIdx != _lastEraUnlockIdx)
        {
            _lastEraUnlockIdx = eraUnlockIdx;
            await Task.Delay(150);
            try
            {
                var color = Config.Eras[eraUnlockIdx].Color;
                await JS.InvokeVoidAsync("AgeOfLiberty.showEraUnlock", "eraUnlockCanvas", color);
            }
            catch { }
        }
        else if (State.EraUnlockAnimIndex == null && _lastEraUnlockIdx != null)
        {
            _lastEraUnlockIdx = null;
            try { await JS.InvokeVoidAsync("AgeOfLiberty.hideEraUnlock"); } catch { }
        }
    }

    private async Task UpdateEdgeParticles()
    {
        var edges = new List<object>();
        foreach (var atom in AvailableAtoms)
        {
            if (State.GetBuiltCount(atom.Id) == 0) continue;
            var deps = Config.GetDependencies(atom.Id);
            foreach (var dep in deps)
            {
                if (!Config.AtomsById.TryGetValue(dep.RequiresAtomId, out var reqAtom)) continue;
                edges.Add(new { x1 = reqAtom.PositionX, y1 = reqAtom.PositionY, x2 = atom.PositionX, y2 = atom.PositionY });
            }
        }
        try { await JS.InvokeVoidAsync("AgeOfLiberty.updateEdges", edges); } catch { }
    }

    [JSInvokable]
    public void OnGestureUpdate(double panX, double panY, double zoom)
    {
        _panX = panX;
        _panY = panY;
        _zoom = zoom;
        InvokeAsync(StateHasChanged);
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async void StartGame()
    {
        if (string.IsNullOrWhiteSpace(State.CityName))
            State.CityName = "Liberty City";
        State.Phase = GamePhase.Play;
        Economy.Start();
        State.NotifyStateChanged();

        // Re-init particles after phase change
        await Task.Delay(200);
        _particlesInitialized = false;
        _gesturesInitialized = false;
        _edgeParticlesInitialized = false;
        StateHasChanged();
    }

    private void SelectAtom(int atomId)
    {
        if (State.SelectedAtomId == atomId)
        {
            State.SelectedAtomId = null;
            State.DrawerOpen = false;
        }
        else
        {
            State.SelectedAtomId = atomId;
            State.DrawerOpen = true;
        }
        State.NotifyStateChanged();
    }

    private void CloseDrawer()
    {
        State.DrawerOpen = false;
        State.SelectedAtomId = null;
        State.NotifyStateChanged();
    }

    private void ToggleChronicle() => _chronicleOpen = !_chronicleOpen;

    private async Task DismissEraUnlock()
    {
        try { await JS.InvokeVoidAsync("AgeOfLiberty.hideEraUnlock"); } catch { }
        // Wait for fade-out animation to complete
        await Task.Delay(850);
        State.EraUnlockAnimIndex = null;
        _lastEraUnlockIdx = null;
        State.NotifyStateChanged();
    }

    private void HandleChoice(int choiceId)
    {
        Scenarios.MakeChoice(choiceId);
        StateHasChanged();
    }

    private void ToggleSummary()
    {
        State.ShowSummary = !State.ShowSummary;
        StateHasChanged();
    }

    private async Task ShareCity()
    {
        var freedom = State.ComputeFreedomScore();
        var text = $"🏛️ {State.CityName}\n{CurrentEra.Name} era · Turn {State.Turn}\n👥 {EconomyEngine.FormatNumber(State.Population)} citizens · 💰 SFL$ {EconomyEngine.FormatNumber(State.Gold)}\n\n🗽 Liberty Index: {freedom.Score}/100 — \"{freedom.Title}\"\nGrade: {freedom.Grade}\n\nCan you build a freer city? 🌍\n#AgeOfLiberty #StudentsForLiberty";
        await JS.InvokeVoidAsync("AgeOfLiberty.shareCity", text);
    }

    private async Task ZoomIn()
    {
        _zoom = Math.Min(2.5, _zoom + 0.2);
        await JS.InvokeVoidAsync("AgeOfLiberty.setGestureState", _panX, _panY, _zoom);
    }

    private async Task ZoomOut()
    {
        _zoom = Math.Max(0.4, _zoom - 0.2);
        await JS.InvokeVoidAsync("AgeOfLiberty.setGestureState", _panX, _panY, _zoom);
    }

    private async Task ZoomReset()
    {
        _zoom = 1; _panX = 0; _panY = 0;
        await JS.InvokeVoidAsync("AgeOfLiberty.resetGesture");
    }

    private void OpenStockView(int atomId)
    {
        _stockViewAtomId = atomId;
        _compareAtomId = null;
        StateHasChanged();
    }

    private void CloseStockView()
    {
        _stockViewAtomId = null;
        _compareAtomId = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        State.OnStateChanged -= OnStateChanged;
        Economy.Stop();
        _dotnetRef?.Dispose();
    }
}
