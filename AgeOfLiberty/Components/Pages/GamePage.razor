        if (wasTyping) return;
        if (TutSteps[_tutStep].WaitDrawer) return;   // this one advances by doing, not tapping
        if (_tutStep + 1 < TutSteps.Length) await ShowTutStep(_tutStep + 1);
        else await FinishTutorial();
