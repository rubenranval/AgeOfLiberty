    private void DrawerTouchStart(TouchEventArgs e) { if (e.Touches.Length > 0) _drawerTouchY = e.Touches[0].ClientY; }
    private void DrawerTouchMove(TouchEventArgs e) { if (e.Touches.Length > 0 && e.Touches[0].ClientY - _drawerTouchY > 60) CloseDrawer(); }

    private async Task HandleChoice(int choiceId)
    {
        SaveService.SaveCheckpoint(State, _eraStartUtc, _eraStartPop, Config.Eras.Select(e => e.Id));
        Scenarios.MakeChoice(choiceId);
        // Issue answered: climb the geometric ladder
        IssueProgress.SetDone(_issueEraId, Math.Min(EraIssuesTotal, IssueProgress.Done(_issueEraId) + 1));
        ScheduleNextIssue();
        try { await JS.InvokeVoidAsync("AgeOfLibertyAudio.sfxChoice"); } catch { }
        StateHasChanged();
    }

    private void RewindToLastIssue()
    {
        var checkpoint = SaveService.LoadCheckpoint();
        if (checkpoint == null) return;
        Economy.CancelPendingWork();
        foreach (var (eraId, count) in checkpoint.IssueProgressByEra)
            IssueProgress.SetDone(eraId, count);
        RestoreFrom(checkpoint);
        State.OusterPressure = 0;
        State.OusterWarningStage = 0;
        State.GameOverReason = null;
        State.ActiveScenario = null;
        State.ActiveDispatchId = null;
        State.ToastDispatchId = null;
        State.Phase = GamePhase.Play;
        _issueHeld = true;
        _autoOpenPending = false;
        _pressureDetailsOpen = false;
        _goalsOpen = false;
        State.NotifyStateChanged();
    }

    private static string FmtEraTime(TimeSpan t)
    {
        if (t.TotalHours >= 1) return $"{(int)t.TotalHours}h {t.Minutes:D2}m";
        return $"{(int)t.TotalMinutes}m {t.Seconds:D2}s";
    }

    private async Task OnEraOverlayTap()
    {
        // Grace period: the announcement pops without warning — swallow the
        // accidental tap that was aimed at something underneath.
        if (_eraRevealPhase != EraRevealPhase.ChestReveal
            && (DateTime.UtcNow - _ceremonyShownAt).TotalMilliseconds < 1400) return;

        if (_eraRevealPhase == EraRevealPhase.ChestReveal)
        {
            await ChestTap();
        }
        else if (_eraRevealPhase == EraRevealPhase.Address)
        {
            await AddressTap();
        }
        else
        {
            await BeginEraAddress();
        }
    }

    /// <summary>Announcement tapped: play the engine's era address if this era
    /// has one (all except the first), otherwise go straight to the chest.
    /// Same visual stage — the badge keeps rotating behind the words.</summary>
    private async Task BeginEraAddress()
    {
        var idx = State.EraUnlockAnimIndex;
        var era = (idx is int i && i >= 0 && i < Config.Eras.Count) ? Config.Eras[i] : null;
        var beats = (era?.EraAddress ?? string.Empty).Replace("\r", "")
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (idx is not int || idx == 0 || beats.Length == 0)
        {
            await TransitionToChest();
            return;
        }
        _addressBeats = beats;
        _addressBeatIdx = 0;
        _eraRevealPhase = EraRevealPhase.Address;
        State.NotifyStateChanged();
        await Task.Delay(80);
        try { await JS.InvokeVoidAsync("AgeOfLibertyEra.addressMode"); } catch { }
        try { await JS.InvokeVoidAsync("AgeOfLibertyIntro.typeText", "eraAddressLine", _addressBeats[0]); } catch { }
    }

    /// <summary>Address tapped: finish the current beat instantly, or advance
    /// to the next beat, or hand over to the chest ceremony.</summary>
    private async Task AddressTap()
    {
        bool wasTyping = false;
        try { wasTyping = await JS.InvokeAsync<bool>("AgeOfLibertyIntro.finishType"); } catch { }
        if (wasTyping) return;
        _addressBeatIdx++;
        if (_addressBeatIdx >= _addressBeats.Length)
        {
            await TransitionToChest();
            return;
        }
        StateHasChanged();
        try { await JS.InvokeVoidAsync("AgeOfLibertyIntro.typeText", "eraAddressLine", _addressBeats[_addressBeatIdx]); } catch { }
    }

    /// <summary>Skip the entire ceremony from the address screen: address,
    /// chest reveal, everything. Mirrors DismissChest's cleanup so the new
    /// era starts cleanly.</summary>
    private async Task SkipCeremony()
    {
        try { await JS.InvokeVoidAsync("AgeOfLibertyEra.fadeOut", 0.35); } catch { }
        await Task.Delay(400);
        if (State.EraUnlockAnimIndex is int skipIdx) _lastCeremonyEra = Math.Max(_lastCeremonyEra, skipIdx);
        State.EraUnlockAnimIndex = null;
        _lastEraUnlockIdx = null;
        _eraRevealPhase = EraRevealPhase.None;
        _eraRevealEraIdx = -1;
        _eraStartUtc = DateTime.UtcNow;
        _eraStartPop = State.Population;
        Economy.Start();
        try { _ = JS.InvokeVoidAsync("AgeOfLibertyJuice.setActive", _activeTab == Tab.Map); } catch { }
        State.NotifyStateChanged();
    }

    private async Task TransitionToChest()
    {
        if (State.EraUnlockAnimIndex is int idx)
        {
            _eraRevealEraIdx = idx;
            _eraRevealPhase = EraRevealPhase.ChestReveal;

            // Clear era state — the 3D scene persists through the transition
            State.EraUnlockAnimIndex = null;
            _lastEraUnlockIdx = null;
            State.NotifyStateChanged();

            // Tell the unified module to transition badge → chest
            await Task.Delay(100);
            try
            {
                var dotnetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("AgeOfLibertyEra.transitionToChest", dotnetRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task OnChestOpened()
    {
        // Called from JS when chest finishes opening — start revealing atom cards
        var chestEra = Config.Eras[_eraRevealEraIdx];
        var newAtoms = Config.Atoms.Where(a => a.EraId == chestEra.Id).ToList();

        await InvokeAsync(StateHasChanged);
        await Task.Delay(100);

        // Reveal cards one by one using the juice module
        for (var i = 0; i < newAtoms.Count; i++)
        {
            try { await JS.InvokeVoidAsync("AgeOfLibertyJuice.revealAtomCard", i); } catch { }
            await Task.Delay(400);
        }

        // Slide chest down to make room for cards + button
        try { await JS.InvokeVoidAsync("AgeOfLibertyEra.slideChestDown"); } catch { }
        await Task.Delay(400);

        // Show continue button
        try { await JS.InvokeVoidAsync("AgeOfLibertyJuice.showChestContinue"); } catch { }
    }

    private async Task ChestTap()
    {
        // Skip — reveal all remaining cards instantly
        var chestEra = Config.Eras[_eraRevealEraIdx];
        var count = Config.Atoms.Count(a => a.EraId == chestEra.Id);
        for (var i = 0; i < count; i++)
        {
            try
            {
                await JS.InvokeVoidAsync("eval",
                    $"var c=document.getElementById('atomCard_{i}');if(c){{c.style.display='flex';c.style.opacity='1';c.style.transform='translateY(0) scale(1)';}}");
            }
            catch { }
        }
        // Slide chest down and show button
        try { await JS.InvokeVoidAsync("AgeOfLibertyEra.slideChestDown"); } catch { }
        try
        {
            await JS.InvokeVoidAsync("eval",
                "var b=document.getElementById('chestContinueBtn');if(b){b.style.display='block';b.style.opacity='1';b.style.transform='translateY(0)';}");
        }
        catch { }
    }

    private async Task DismissChest()
    {
        try { await JS.InvokeVoidAsync("AgeOfLibertyEra.fadeOut", 0.5); } catch { }
        await Task.Delay(550);
        _lastCeremonyEra = Math.Max(_lastCeremonyEra, _eraRevealEraIdx);
        _eraRevealPhase = EraRevealPhase.None;
        _eraRevealEraIdx = -1;
        // New era begins: reset baselines and unfreeze the simulation
        _eraStartUtc = DateTime.UtcNow;
        _eraStartPop = State.Population;
        Economy.Start();
        try { _ = JS.InvokeVoidAsync("AgeOfLibertyJuice.setActive", _activeTab == Tab.Map); } catch { }
        StateHasChanged();
    }

    private async Task ShareCity()
    {
        var freedom = State.ComputeFreedomScore();
        var text = $"🏛️ {State.CityName}\n{CurrentEra.Name} era · Turn {State.Turn}\n👥 {EconomyEngine.FormatNumber(State.Population)} citizens · 💰 ${EconomyEngine.FormatNumber(State.Gold)}\n\n🗽 Liberty Index: {freedom.Score}/100 — \"{freedom.Title}\"\n\nCan you build a freer city?\n#AgeOfLiberty";
        await JS.InvokeVoidAsync("AgeOfLiberty.shareCity", text);
