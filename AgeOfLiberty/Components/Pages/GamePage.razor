    /// <summary>Polygon points for the civic fingerprint radar.</summary>
    private static string RadarPoints(int axes, double cx, double cy, double r, Func<int, double> valueAt)
    {
        var pts = new System.Text.StringBuilder();
        for (var i = 0; i < axes; i++)
        {
            var ang = -Math.PI / 2 + i * 2 * Math.PI / axes;
            var rr = r * Math.Clamp(valueAt(i), 0, 100) / 100.0;
            pts.Append($"{cx + rr * Math.Cos(ang):F1},{cy + rr * Math.Sin(ang):F1} ");
        }
        return pts.ToString().TrimEnd();
    }

