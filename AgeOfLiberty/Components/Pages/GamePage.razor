    private void MigrateLegacyDispatches()
    {
        if (State.ChoiceEvents.Count == 0) return;
        var knownChoices = State.Dispatches.Select(d => (d.ChoiceId, d.DecisionTurn)).ToHashSet();
        foreach (var choiceEvent in State.ChoiceEvents.Where(e => e.ChoiceId != 0))
        {
            if (knownChoices.Contains((choiceEvent.ChoiceId, choiceEvent.Turn))) continue;
            var choice = Config.Choices.FirstOrDefault(c => c.Id == choiceEvent.ChoiceId);
            State.Dispatches.Add(new GameDispatch
            {
                ChoiceId = choiceEvent.ChoiceId,
                DecisionTurn = choiceEvent.Turn,
                EventTurn = choiceEvent.Turn,
                Cause = choiceEvent.Label,
                ImmediateOutcome = choice?.Feedback ?? "Recorded before Dispatches was introduced.",
                IsRead = true,
                LearnUrl = choice?.LearnUrl,
                LearnLabel = choice?.LearnLabel,
            });
        }
        if (State.Dispatches.Count > 120)
            State.Dispatches.RemoveRange(0, State.Dispatches.Count - 120);
    }

