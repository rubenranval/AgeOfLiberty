    private int[] GetThresholdsForAtom(Atom atom)
    {
        // Find which era index this atom belongs to (0-5)
        var eraIdx = 0;
        for (int i = 0; i < Config.Eras.Count; i++)
        {
            if (Config.Eras[i].Id == atom.EraId) { eraIdx = i; break; }
        }
        if (eraIdx <= 1) return BadgeThresholds[0];
        if (eraIdx <= 3) return BadgeThresholds[1];
        return BadgeThresholds[2];
    }

    private int GetBadgeTier(int atomId)
    {
        var count = State.GetBuiltCount(atomId);
        if (!Config.AtomsById.TryGetValue(atomId, out var atom)) return 0;
        var thresholds = GetThresholdsForAtom(atom);
        int tier = 0;
        for (int i = 0; i < thresholds.Length; i++)
        {
            if (count >= thresholds[i]) tier = i + 1;
        }
        return tier; // 0=none, 1=bronze, 2=silver, 3=gold, 4=platinum, 5=diamond
    }

    private int GetNextThreshold(int atomId)
    {
        var count = State.GetBuiltCount(atomId);
        if (!Config.AtomsById.TryGetValue(atomId, out var atom)) return 0;
        var thresholds = GetThresholdsForAtom(atom);
        foreach (var t in thresholds)
        {
            if (count < t) return t;
        }
        return thresholds[^1]; // already maxed
    }

    private double GetBadgeProgress(int atomId)
    {
        var count = State.GetBuiltCount(atomId);
        if (!Config.AtomsById.TryGetValue(atomId, out var atom)) return 0;
        var thresholds = GetThresholdsForAtom(atom);
        int prevThreshold = 0;
        foreach (var t in thresholds)
        {
            if (count < t) return (double)(count - prevThreshold) / (t - prevThreshold);
            prevThreshold = t;
        }
        return 1.0; // maxed out
    }

