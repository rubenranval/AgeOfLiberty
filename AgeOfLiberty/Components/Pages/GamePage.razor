    private async Task OnEraOverlayTap()
    {
        // Grace period: the announcement pops without warning — swallow the
        // accidental tap that was aimed at something underneath.
        if (_eraRevealPhase != EraRevealPhase.ChestReveal
            && (DateTime.UtcNow - _ceremonyShownAt).TotalMilliseconds < 1400) return;

        if (_eraRevealPhase == EraRevealPhase.ChestReveal)
        {
            await ChestTap();
        }
        else
        {
            await TransitionToChest();
        }
    }

    private async Task TransitionToChest()
    {
        if (State.EraUnlockAnimIndex is int idx)
        {
            _eraRevealEraIdx = idx;
            _eraRevealPhase = EraRevealPhase.ChestReveal;

            // Clear era state — the 3D scene persists through the transition
            State.EraUnlockAnimIndex = null;
            _lastEraUnlockIdx = null;
            State.NotifyStateChanged();

            // Tell the unified module to transition badge → chest
            await Task.Delay(100);
            try
            {
                var dotnetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("AgeOfLibertyEra.transitionToChest", dotnetRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task OnChestOpened()
    {
        // Called from JS when chest finishes opening — start revealing atom cards
        var chestEra = Config.Eras[_eraRevealEraIdx];
        var newAtoms = Config.Atoms.Where(a => a.EraId == chestEra.Id).ToList();

        await InvokeAsync(StateHasChanged);
        await Task.Delay(100);

        // Reveal cards one by one using the juice module
        for (var i = 0; i < newAtoms.Count; i++)
        {
            try { await JS.InvokeVoidAsync("AgeOfLibertyJuice.revealAtomCard", i); } catch { }
            await Task.Delay(400);
        }

        // Slide chest down to make room for cards + button
        try { await JS.InvokeVoidAsync("AgeOfLibertyEra.slideChestDown"); } catch { }
        await Task.Delay(400);

        // Show continue button
        try { await JS.InvokeVoidAsync("AgeOfLibertyJuice.showChestContinue"); } catch { }
    }

    private async Task ChestTap()
    {
        // Skip — reveal all remaining cards instantly
        var chestEra = Config.Eras[_eraRevealEraIdx];
        var count = Config.Atoms.Count(a => a.EraId == chestEra.Id);
        for (var i = 0; i < count; i++)
        {
            try
            {
                await JS.InvokeVoidAsync("eval",
                    $"var c=document.getElementById('atomCard_{i}');if(c){{c.style.display='flex';c.style.opacity='1';c.style.transform='translateY(0) scale(1)';}}");
            }
            catch { }
        }
        // Slide chest down and show button
        try { await JS.InvokeVoidAsync("AgeOfLibertyEra.slideChestDown"); } catch { }
        try
        {
            await JS.InvokeVoidAsync("eval",
                "var b=document.getElementById('chestContinueBtn');if(b){b.style.display='block';b.style.opacity='1';b.style.transform='translateY(0)';}");
        }
        catch { }
    }

    private async Task DismissChest()
    {
        try { await JS.InvokeVoidAsync("AgeOfLibertyEra.fadeOut", 0.5); } catch { }
        await Task.Delay(550);
        _lastCeremonyEra = Math.Max(_lastCeremonyEra, _eraRevealEraIdx);
        _eraRevealPhase = EraRevealPhase.None;
        _eraRevealEraIdx = -1;
        // New era begins: reset baselines and unfreeze the simulation
        _eraStartUtc = DateTime.UtcNow;
        _eraStartPop = State.Population;
        Economy.Start();
        try { _ = JS.InvokeVoidAsync("AgeOfLibertyJuice.setActive", _activeTab == Tab.Map); } catch { }
        StateHasChanged();
    }

    private async Task ShareCity()
    {
        var freedom = State.ComputeFreedomScore();
        var text = $"🏛️ {State.CityName}\n{CurrentEra.Name} era · Turn {State.Turn}\n👥 {EconomyEngine.FormatNumber(State.Population)} citizens · 💰 ${EconomyEngine.FormatNumber(State.Gold)}\n\n🗽 Liberty Index: {freedom.Score}/100 — \"{freedom.Title}\"\n\nCan you build a freer city?\n#AgeOfLiberty";
        await JS.InvokeVoidAsync("AgeOfLiberty.shareCity", text);
    }

    private bool _buildMenuOpen;

    private async void BuildMany(int atomId, int count)
    {
        _buildMenuOpen = false;
        if (!Config.AtomsById.TryGetValue(atomId, out var atom)) { StateHasChanged(); return; }
        int built = 0;
        long spent = 0;
        for (int i = 0; i < count; i++)
        {
            var unitCost = State.GetBuildCost(atom, Config);
            if (!Economy.TryBuild(atomId)) break;
            built++;
            spent += unitCost;
        }
        if (built > 0)
        {
            try
            {
                await JS.InvokeVoidAsync("AgeOfLibertyAudio.sfxBuild");
                await JS.InvokeVoidAsync("AgeOfLibertyJuice.buildCelebrationAt",
                    "atomSvg", atom.PositionX, RY(atom), atom.PopGain * built, spent);
                await JS.InvokeVoidAsync("AgeOfLibertyJuice.floatText",
                    "atomSvg", atom.PositionX, RY(atom) - 46, $"×{built} built", "#f0c860");
                await JS.InvokeVoidAsync("AgeOfLibertyJuice.hudBump", "hudGold");
            }
            catch { }
            await CheckAndShowBadge(atomId);
        }
        StateHasChanged();
    }

    private async void BuildAtom(int atomId)
    {
        if (Config.AtomsById.TryGetValue(atomId, out var atom))
        {
            var cost = State.GetBuildCost(atom, Config);
            if (Economy.TryBuild(atomId))
            {
                try
                {
                    await JS.InvokeVoidAsync("AgeOfLibertyAudio.sfxBuild");
                    await JS.InvokeVoidAsync("AgeOfLibertyJuice.buildCelebrationAt",
                        "atomSvg", atom.PositionX, RY(atom), atom.PopGain, cost);
                    await JS.InvokeVoidAsync("AgeOfLibertyJuice.hudBump", "hudGold");
                }
                catch { }
                // Check for new badge
                await CheckAndShowBadge(atomId);
            }
        }
        StateHasChanged();
    }

    private async Task ZoomIn() { _zoom = Math.Min(2.5, _zoom + 0.2); try { await JS.InvokeVoidAsync("AgeOfLiberty.setGestureState", _panX, _panY, _zoom); } catch { } }
    private async Task ZoomOut() { _zoom = Math.Max(0.4, _zoom - 0.2); try { await JS.InvokeVoidAsync("AgeOfLiberty.setGestureState", _panX, _panY, _zoom); } catch { } }
    private async Task ZoomReset() { _zoom = 1; _panX = 0; _panY = 0; try { await JS.InvokeVoidAsync("AgeOfLiberty.resetGesture"); } catch { } }

    private void OpenStockView(int atomId)
    {
        _selectedMarker = null; _stockViewAtomId = atomId; _compareAtomId = null; StateHasChanged();
    }
    private void CloseStockView()
    {
        _selectedMarker = null; _stockViewAtomId = null; _compareAtomId = null; StateHasChanged();
    }

    private async Task OnMusicVolumeChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var val)) { _musicVolume = val / 100.0; try { await JS.InvokeVoidAsync("AgeOfLibertyAudio.setMusicVolume", _musicVolume); } catch { } }
    }
    private async Task OnSfxVolumeChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var val)) { _sfxVolume = val / 100.0; try { await JS.InvokeVoidAsync("AgeOfLibertyAudio.setSfxVolume", _sfxVolume); } catch { } }
    }

    public void Dispose()
    {
        FlushTimePlayed();
        if (State.Phase != GamePhase.Intro) SaveService.Save(State, _eraStartUtc, _eraStartPop);
        State.OnStateChanged -= OnStateChanged;
        Economy.Stop();
        _issueTicker?.Stop();
        _issueTicker?.Dispose();
        _dotnetRef?.Dispose();
    }
}
