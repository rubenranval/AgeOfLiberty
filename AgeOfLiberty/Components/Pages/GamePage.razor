    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _introCts?.Cancel();
        _introCts?.Dispose();
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        FlushTimePlayed();
        if (State.Phase != GamePhase.Intro) SaveService.Save(State, _eraStartUtc, _eraStartPop);
        State.OnStateChanged -= OnStateChanged;
        Economy.Stop();
        Economy.CancelPendingWork();
        _issueTicker?.Stop();
        _issueTicker?.Dispose();
        try { await JS.InvokeVoidAsync("AgeOfLiberty.dispose"); } catch { }
        _dotnetRef?.Dispose();
    }
