    // ─── Chart Helpers ───────────────────────────────────────────────────
    private string BuildSmoothPath(List<int> data, double padX, double chartW, double padY, double chartH, double minVal, double range, int totalCount)
    {
        if (data.Count < 2) return "";
        var pts = data.Select((v, i) => (
            x: padX + (double)i / Math.Max(1, totalCount - 1) * chartW,
            y: padY + (1.0 - (double)(v - minVal) / Math.Max(1, range)) * chartH
        )).ToList();
        var sb = new System.Text.StringBuilder();
        sb.Append($"M {pts[0].x:F1},{pts[0].y:F1}");
        for (int i = 1; i < pts.Count; i++)
        {
            var p0 = i > 1 ? pts[i - 2] : pts[i - 1];
            var p1 = pts[i - 1];
            var p2 = pts[i];
            var p3 = i < pts.Count - 1 ? pts[i + 1] : pts[i];
            double tension = 0.35;
            var cp1x = p1.x + (p2.x - p0.x) * tension;
            var cp1y = p1.y + (p2.y - p0.y) * tension;
            var cp2x = p2.x - (p3.x - p1.x) * tension;
            var cp2y = p2.y - (p3.y - p1.y) * tension;
            sb.Append($" C {cp1x:F1},{cp1y:F1} {cp2x:F1},{cp2y:F1} {p2.x:F1},{p2.y:F1}");
        }
        return sb.ToString();
    }

    private string BuildSparklinePath(List<int> data, double w, double h, double pad)
    {
        if (data.Count < 2) return "";
        var minVal = data.Min(); var maxVal = data.Max();
        var range = Math.Max(maxVal - minVal, 1);
        return BuildSmoothPath(data, 0, w, pad, h - pad * 2, minVal, range, data.Count);
    }

    private List<int> GetPaddedPrices(int atomId, int basePrice)
    {
        var history = State.PriceHistory;
        var prices = history.Select(h => h.Prices.GetValueOrDefault(atomId, basePrice)).ToList();
        // If less than 3 data points, pad with base price so charts always show something
        while (prices.Count < 3)
        {
            prices.Insert(0, basePrice);
        }
        return prices;
    }

