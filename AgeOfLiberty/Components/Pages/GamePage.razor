    private async Task StartGame()
    {
        if (string.IsNullOrWhiteSpace(State.CityName)) State.CityName = "Liberty City";
        State.Phase = GamePhase.Play;
        Economy.Start();
        // Fresh experiment: clear old save + reset the issue ladder
        SaveService.Delete();
        IssueProgress.Reset(Config.Eras.Select(e => e.Id));
        State.HighestEraIndex = Config.GetEraIndex(State.Population);
        Pressure.EnsureGoals(State.HighestEraIndex);
        await NotificationHelper.RequestPermissionAsync();
        _issueEraId = -1;
        _lastCeremonyEra = 0;
        _eraStartUtc = DateTime.UtcNow;
        _eraStartPop = State.Population;
        StartIssueTicker();
        if (!Preferences.Get("aol_tutorial_done", false)) _ = RunTutorial();
        // Initialize badge tracking with current state
        foreach (var atom in Config.Atoms)
        {
            _lastBadgeTiers[atom.Id] = GetBadgeTier(atom.Id);
        }
        State.NotifyStateChanged();
        await JS.InvokeVoidAsync("AgeOfLibertyAudio.init");
        await JS.InvokeVoidAsync("AgeOfLibertyAudio.playMusic");
        try { _musicVolume = await JS.InvokeAsync<double>("AgeOfLibertyAudio.getMusicVolume"); _sfxVolume = await JS.InvokeAsync<double>("AgeOfLibertyAudio.getSfxVolume"); } catch { }
        await Task.Delay(200);
        _particlesInitialized = false;
        _gesturesInitialized = false;
        _edgeParticlesInitialized = false;
        StateHasChanged();
    }

